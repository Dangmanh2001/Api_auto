<!DOCTYPE html>
<html lang="vi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Google Flow - Tạo ảnh Timeslap</title>
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20,400,0,0"
    />
    <style>
      :root {
        --bg-dark: #1a1c1e;
        --card-bg: #212429;
        --border-color: #3f444c;
        --text-main: #e2e2e2;
        --text-dim: #9aa0a6;
        --accent-blue: #4d94ff;
      }

      body {
        background-color: var(--bg-dark);
        color: var(--text-main);
        font-family: "Segoe UI", Roboto, sans-serif;
        padding: 40px;
        display: flex;
        justify-content: center;
        box-sizing: border-box;
      }

      .container {
        max-width: 850px;
        width: 100%;
      }

      nav {
        width: 100%;
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 40px;
        flex-wrap: wrap;
      }

      .nav-brand {
        font-size: 18px;
        font-weight: bold;
        color: white;
        text-decoration: none;
        margin-right: 16px;
      }

      nav a {
        text-decoration: none;
        color: var(--text-dim);
        font-size: 14px;
        padding: 6px 12px;
        border-radius: 20px;
        border: 1px solid transparent;
        transition: all 0.2s;
      }

      nav a:hover {
        color: var(--text-main);
        border-color: var(--border-color);
      }

      nav a.active {
        color: var(--accent-blue);
        border-color: var(--accent-blue);
      }

      .section-title {
        margin-bottom: 20px;
        font-size: 18px;
        font-weight: 500;
        padding-left: 10px;
      }

      .config-panel {
        background-color: var(--card-bg);
        border: 1px solid var(--border-color);
        border-radius: 16px;
        padding: 24px;
        display: flex;
        flex-direction: column;
        gap: 25px;
      }

      .main-layout {
        display: flex;
        gap: 25px;
        align-items: flex-start;
      }

      .image-upload-box {
        flex-shrink: 0;
        display: flex;
        flex-direction: column;
        gap: 10px;
        width: 200px;
      }

      .image-upload-box span {
        font-size: 13px;
        color: var(--text-dim);
        font-weight: 500;
      }

      .thumbnail-preview {
        width: 100%;
        aspect-ratio: 16/9;
        border-radius: 12px;
        object-fit: cover;
        border: 2px dashed var(--border-color);
        background: #131517;
        cursor: pointer;
        transition: border-color 0.2s;
      }

      .thumbnail-preview:hover {
        border-color: var(--accent-blue);
      }

      .form-content {
        flex-grow: 1;
        display: flex;
        flex-direction: column;
        gap: 20px;
      }

      .input-group {
        display: flex;
        flex-direction: column;
        gap: 8px;
      }

      .input-group label {
        font-size: 13px;
        color: var(--text-dim);
        font-weight: 600;
      }

      .custom-input,
      .custom-textarea {
        background: #131517;
        border: 1px solid var(--border-color);
        border-radius: 8px;
        padding: 12px;
        color: #fff;
        font-size: 14px;
        outline: none;
        font-family: inherit;
      }

      .custom-textarea {
        height: 100px;
        resize: vertical;
      }

      .custom-input:focus,
      .custom-textarea:focus {
        border-color: var(--accent-blue);
      }

      .custom-textarea.drag-over {
        border: 2px dashed var(--accent-blue) !important;
        background: rgba(77, 148, 255, 0.05);
      }

      .image-upload-box.drag-over .thumbnail-preview {
        border-color: var(--accent-blue);
        background: rgba(77, 148, 255, 0.1);
      }

      .prompt-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 2px;
      }

      .btn-import-txt {
        background: none;
        border: 1px solid var(--border-color);
        color: var(--text-dim);
        padding: 3px 10px;
        border-radius: 6px;
        font-size: 11px;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 4px;
        transition: all 0.2s;
      }

      .btn-import-txt:hover {
        background: #2a2e34;
        color: var(--text-main);
        border-color: var(--accent-blue);
      }

      .settings-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
        gap: 20px;
        border-top: 1px solid var(--border-color);
        padding-top: 20px;
      }

      .select-wrapper {
        position: relative;
      }

      .custom-select {
        width: 100%;
        appearance: none;
        background-color: #131517;
        color: var(--text-main);
        border: 1px solid var(--border-color);
        border-radius: 8px;
        padding: 10px 30px 10px 12px;
        font-size: 14px;
        cursor: pointer;
      }

      .select-wrapper::after {
        content: "expand_more";
        font-family: "Material Symbols Outlined";
        position: absolute;
        right: 10px;
        top: 50%;
        transform: translateY(-50%);
        color: var(--text-dim);
        pointer-events: none;
      }

      .footer {
        margin-top: 30px;
        display: flex;
        justify-content: flex-end;
      }

      .btn-submit {
        background: var(--accent-blue);
        color: white;
        border: none;
        padding: 12px 30px;
        border-radius: 30px;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 10px;
        font-weight: 600;
        transition: transform 0.1s;
      }

      .btn-submit:active {
        transform: scale(0.98);
      }

      @media (max-width: 640px) {
        .main-layout {
          flex-direction: column;
        }
        .image-upload-box {
          width: 100%;
        }
      }
    </style>
  </head>
  <body>
    <div id="page-root">
      <div class="container">
        <nav>
      <a class="nav-brand">API Tool</a>
      <a href="/">Home</a>
      <a href="/api">Text To Video</a>
      <a href="/api/gemini">Gemini</a>
      <a href="/api/imageToVideo">Image To Video</a>
      <a href="/api/IngredientsToVideo">Ingredients To Video</a>
      <a href="/api/clone-channel">Clone YouTube</a>
      <a href="/api/textToImage">Text To Image</a>
        <a href="/api/timeslapImage" class="active">Timeslap Image</a>
        </nav>

        <div class="section-title">Cấu hình render Timeslap</div>

        <form
          id="timeslapForm"
          action="/api/timeslapImage"
          method="POST"
          enctype="multipart/form-data"
        >
          <div class="config-panel">
            <div class="main-layout">
              <div class="image-upload-box">
                <span>Ảnh gốc (Ảnh 1)</span>
                <img
                  id="imgPreview"
                    src="https://cdn-media.sforum.vn/storage/app/media/ctvseo_maihue/hinh-nen-1920-1080/hinh-nen-1920-1080-thumbnail.jpg"
                  class="thumbnail-preview"
                  onclick="document.getElementById('fileInput').click()"
                />
                <input
                  type="file"
                  id="fileInput"
                  name="initialImage"
                  accept="image/*"
                  style="display: none"
                  onchange="previewImage(this)"
                />
              </div>

              <div class="form-content">
                <div class="input-group">
                  <div class="prompt-header">
                    <label for="prompt">Câu lệnh (Prompt)</label>
                    <button type="button" class="btn-import-txt" onclick="document.getElementById('promptFileInput').click()">
                      <span class="material-symbols-outlined" style="font-size: 16px;">upload_file</span>
                      Import .txt
                    </button>
                  </div>
                  <input type="file" id="promptFileInput" accept=".txt" style="display: none" />
                  <textarea
                    id="prompt"
                    name="prompt"
                    class="custom-textarea"
                    placeholder="Continue this same landscape as a time-lapse sequence, keep the same camera angle and location, advance the time naturally, cinematic realistic detail (Mỗi dòng là 1 prompt tiếp theo)..."
                  ></textarea>
                </div>

                <div class="input-group">
                  <label for="imageCount"
                    >Số lượng ảnh muốn tạo (Tổng cộng)</label
                  >
                  <input
                    type="number"
                    id="imageCount"
                    name="imageCount"
                    class="custom-input"
                    value="5"
                    min="2"
                    required
                  />
                </div>
              </div>
            </div>

            <div class="settings-grid">
              <div class="input-group">
                <label>Tỉ lệ khung hình:</label>
                <div class="select-wrapper">
                  <select name="aspectRatio" class="custom-select">
                    <option value="16:9" selected>16:9 (Ngang)</option>
                    <option value="4:3">4:3</option>
                    <option value="1:1">1:1 (Vuông)</option>
                    <option value="3:4">3:4</option>
                    <option value="9:16">9:16 (Dọc)</option>
                  </select>
                </div>
              </div>

              <div class="input-group">
                <label>Model:</label>
                <div class="select-wrapper">
                  <select name="modelType" class="custom-select">
                    <% if (typeof imageModels !== 'undefined') { %>
                      <% imageModels.forEach(model => { %>
                        <option value="<%= model %>"><%= model %></option>
                      <% }); %>
                    <% } %>
                  </select>
                </div>
              </div>
            </div>
          </div>

          <div class="footer">
            <button type="submit" class="btn-submit">
              Bắt đầu tạo
              <span class="material-symbols-outlined">bolt</span>
            </button>
          </div>
        </form>
      </div>
    </div>

    <script>
      function previewImage(input) {
        if (input.files && input.files[0]) {
          const reader = new FileReader();
          reader.onload = (e) => {
            document.getElementById("imgPreview").src = e.target.result;
          };
          reader.readAsDataURL(input.files[0]);
        }
      }

    // Xử lý kéo thả ảnh vào khu vực upload
    const imageUploadBox = document.querySelector(".image-upload-box");
    
    imageUploadBox.addEventListener("dragover", (e) => {
      e.preventDefault();
      imageUploadBox.classList.add("drag-over");
    });

    imageUploadBox.addEventListener("dragleave", () => {
      imageUploadBox.classList.remove("drag-over");
    });

    imageUploadBox.addEventListener("drop", (e) => {
      e.preventDefault();
      imageUploadBox.classList.remove("drag-over");

      if (e.dataTransfer.files && e.dataTransfer.files[0]) {
        const file = e.dataTransfer.files[0];
        if (file.type.startsWith("image/")) {
          const fileInput = document.getElementById("fileInput");
          fileInput.files = e.dataTransfer.files;
          previewImage(fileInput);
        }
      }
    });

    // Xử lý kéo thả file .txt vào ô Prompt
    const promptArea = document.getElementById("prompt");
    const imageCountInput = document.getElementById("imageCount");

    // Hàm tự động cập nhật số lượng ảnh dựa trên số dòng prompt
    function updateCountFromPrompt() {
      const text = promptArea.value.trim();
      console.log("DEBUG: Raw promptArea.value:", JSON.stringify(promptArea.value)); // Log nội dung thô của textarea
      console.log("DEBUG: Trimmed promptArea.value:", JSON.stringify(text)); // Log nội dung đã trim

      if (!text) {
        console.log("DEBUG: Prompt area is empty after trim, returning.");
        return;
      }
      
      // Sử dụng regex bao quát hơn: \r\n (Windows), \n (Unix), \r (Mac cũ)
      const lines = text.split(/\r\n|\r|\n/).map(l => l.trim()).filter(l => l !== "");
      console.log("DEBUG: Split and filtered lines:", lines); // Log mảng các dòng đã được xử lý
      if (lines.length > 0) {
        // Tổng số ảnh (bao gồm cả ảnh gốc) sẽ khớp với số lượng dòng lệnh đã nhập
        imageCountInput.value = Math.max(2, lines.length);
        console.log("DEBUG: Calculated imageCountInput.value:", imageCountInput.value);
      }
    }

    promptArea.addEventListener("input", updateCountFromPrompt);

    // Xử lý khi chọn file từ nút Import
    document.getElementById('promptFileInput').addEventListener('change', function(e) {
      const file = e.target.files[0];
      if (file) {
        const reader = new FileReader();
        reader.onload = (event) => {
          promptArea.value = event.target.result;
          updateCountFromPrompt();
          console.log("✅ Đã import file .txt thành công");
        };
        reader.readAsText(file);
      }
      this.value = ''; // Reset để có thể chọn lại cùng 1 file nếu cần
    });

    promptArea.addEventListener("dragover", (e) => {
      e.preventDefault();
      promptArea.classList.add("drag-over");
    });

    promptArea.addEventListener("dragleave", () => {
      promptArea.classList.remove("drag-over");
    });

    promptArea.addEventListener("drop", (e) => {
      e.preventDefault();
      promptArea.classList.remove("drag-over");

      const file = e.dataTransfer.files[0];
      if (file && (file.type === "text/plain" || file.name.endsWith(".txt"))) {
        const reader = new FileReader();
        reader.onload = (event) => {
          promptArea.value = event.target.result;
          updateCountFromPrompt();
        };
        reader.readAsText(file);
      }
    });

  // Validation trước khi submit form
  document.getElementById("timeslapForm").addEventListener("submit", function (e) {
    const fileInput = document.getElementById('fileInput');

    // 1. Kiểm tra đã chọn ảnh gốc hay chưa
    if (!fileInput.files || fileInput.files.length === 0) {
      e.preventDefault();
      alert("Vui lòng chọn ảnh gốc (Ảnh 1) trước khi bắt đầu tạo Timeslap.");
      return;
    }

    const textForValidation = promptArea.value.trim();
    console.log("DEBUG (Validation): Raw promptArea.value:", JSON.stringify(promptArea.value));
    console.log("DEBUG (Validation): Trimmed promptArea.value:", JSON.stringify(textForValidation));

    if (!textForValidation) return; // Nếu để trống thì dùng logic mặc định ở server

    const lines = textForValidation.split(/\r\n|\r|\n/).map(l => l.trim()).filter(l => l !== "");
    console.log("DEBUG (Validation): Split and filtered lines:", lines);
    const count = parseInt(imageCountInput.value);

    // Tổng số ảnh phải tối thiểu bằng số lượng dòng lệnh đã nhập
    if (count < lines.length) {
      e.preventDefault();
      alert(`Số lượng ảnh (${count}) không phù hợp với số dòng lệnh (${lines.length} dòng). \nBạn cần đặt số lượng ảnh ít nhất là ${lines.length} để khớp với danh sách câu lệnh.`);
    }
  });
    </script>
    <script src="/javascripts/spa.js"></script>
  </body>
</html>
