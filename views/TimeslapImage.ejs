<!DOCTYPE html>
<html lang="vi">
  <head>
    <meta charset="UTF-8" />
    <title>Timeslap Image</title>
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20,400,0,0"
    />
    <style>
      :root {
        --bg-dark: #151719;
        --card-bg: #20242a;
        --panel-bg: #15181d;
        --border-color: #3d444f;
        --text-main: #f2f4f8;
        --text-dim: #9aa4b2;
        --accent-blue: #4d94ff;
        --accent-amber: #f4b860;
        --accent-green: #81c995;
      }

      body {
        min-height: 100vh;
        margin: 0;
        background:
          radial-gradient(circle at 15% 10%, rgba(244, 184, 96, 0.18), transparent 30%),
          radial-gradient(circle at 85% 20%, rgba(77, 148, 255, 0.15), transparent 28%),
          linear-gradient(135deg, #111316, #1b2028 55%, #121417);
        color: var(--text-main);
        font-family: "Segoe UI", Roboto, Arial, sans-serif;
      }

      .page {
        max-width: 980px;
        margin: 0 auto;
        padding: 36px 20px 60px;
      }

      nav {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 34px;
        flex-wrap: wrap;
      }

      .nav-brand {
        font-size: 18px;
        font-weight: 700;
        color: white;
        text-decoration: none;
        margin-right: 16px;
      }

      nav a {
        text-decoration: none;
        color: var(--text-dim);
        font-size: 14px;
        padding: 6px 12px;
        border-radius: 999px;
        border: 1px solid transparent;
      }

      nav a:hover {
        color: var(--text-main);
        border-color: var(--border-color);
      }

      nav a.active {
        color: var(--accent-amber);
        border-color: var(--accent-amber);
      }

      .hero {
        margin-bottom: 22px;
      }

      .hero h1 {
        margin: 0 0 8px;
        font-size: 34px;
        letter-spacing: -0.04em;
      }

      .hero p {
        margin: 0;
        color: var(--text-dim);
        line-height: 1.6;
      }

      form {
        background: rgba(32, 36, 42, 0.92);
        border: 1px solid var(--border-color);
        border-radius: 22px;
        padding: 26px;
        box-shadow: 0 24px 70px rgba(0, 0, 0, 0.35);
      }

      .grid {
        display: grid;
        grid-template-columns: 1.1fr 0.9fr;
        gap: 20px;
      }

      .form-group {
        margin-bottom: 18px;
      }

      label {
        display: block;
        margin-bottom: 10px;
        color: var(--text-dim);
        font-size: 13px;
        font-weight: 600;
      }

      textarea,
      input[type="text"] {
        width: 100%;
        box-sizing: border-box;
        background: var(--panel-bg);
        border: 1px solid var(--border-color);
        border-radius: 14px;
        color: #fff;
        padding: 14px;
        font-size: 14px;
        line-height: 1.5;
        outline: none;
      }

      textarea {
        resize: vertical;
      }

      textarea:focus,
      input[type="text"]:focus {
        border-color: var(--accent-amber);
      }

      .image-dropzone {
        position: relative;
        display: grid;
        grid-template-columns: 96px 1fr;
        gap: 16px;
        align-items: center;
        min-height: 132px;
        padding: 16px;
        border: 1px dashed rgba(244, 184, 96, 0.55);
        border-radius: 18px;
        background:
          linear-gradient(135deg, rgba(244, 184, 96, 0.11), rgba(77, 148, 255, 0.06)),
          var(--panel-bg);
        cursor: pointer;
        transition: border-color 0.2s ease, transform 0.2s ease, background 0.2s ease;
      }

      .image-dropzone:hover,
      .image-dropzone.drag-over {
        border-color: var(--accent-amber);
        transform: translateY(-1px);
        background:
          linear-gradient(135deg, rgba(244, 184, 96, 0.18), rgba(77, 148, 255, 0.08)),
          var(--panel-bg);
      }

      .image-dropzone input[type="file"] {
        position: absolute;
        width: 1px;
        height: 1px;
        opacity: 0;
        pointer-events: none;
      }

      .image-preview {
        width: 96px;
        height: 96px;
        border-radius: 16px;
        border: 1px solid rgba(255, 255, 255, 0.08);
        background: rgba(0, 0, 0, 0.22);
        display: grid;
        place-items: center;
        overflow: hidden;
      }

      .image-preview img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: none;
      }

      .image-preview.has-image img {
        display: block;
      }

      .image-preview.has-image .material-symbols-outlined {
        display: none;
      }

      .image-preview .material-symbols-outlined {
        color: var(--accent-amber);
        font-size: 34px;
      }

      .image-drop-title {
        margin: 0 0 6px;
        color: var(--text-main);
        font-weight: 700;
      }

      .image-drop-meta {
        margin: 0;
        color: var(--text-dim);
        font-size: 13px;
        line-height: 1.5;
      }

      .image-actions {
        display: flex;
        gap: 8px;
        margin-top: 12px;
        flex-wrap: wrap;
      }

      .image-action-btn {
        border: 1px solid rgba(244, 184, 96, 0.45);
        background: rgba(244, 184, 96, 0.09);
        color: var(--accent-amber);
        padding: 7px 11px;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 700;
        cursor: pointer;
      }

      .image-action-btn.secondary {
        border-color: var(--border-color);
        background: rgba(255, 255, 255, 0.04);
        color: var(--text-dim);
      }

      small {
        display: block;
        margin-top: 8px;
        color: var(--text-dim);
        font-size: 12px;
      }

      .settings-row {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 14px;
        margin-top: 10px;
      }

      .custom-select {
        width: 100%;
        appearance: none;
        background: var(--panel-bg);
        color: var(--text-main);
        border: 1px solid var(--border-color);
        border-radius: 12px;
        padding: 12px;
        font-size: 14px;
        outline: none;
      }

      .preview-card {
        border: 1px solid rgba(244, 184, 96, 0.35);
        background: linear-gradient(160deg, rgba(244, 184, 96, 0.1), rgba(77, 148, 255, 0.07));
        border-radius: 18px;
        padding: 18px;
        min-height: 240px;
      }

      .preview-card h2 {
        margin: 0 0 12px;
        font-size: 17px;
      }

      .preview-list {
        display: grid;
        gap: 10px;
        margin: 0;
        padding: 0;
        list-style: none;
      }

      .preview-list li {
        padding: 10px 12px;
        border-radius: 12px;
        background: rgba(0, 0, 0, 0.22);
        color: var(--text-dim);
        font-size: 13px;
      }

      .footer {
        display: flex;
        justify-content: flex-end;
        margin-top: 22px;
      }

      button[type="submit"] {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 12px 22px;
        border: 0;
        border-radius: 999px;
        background: var(--accent-amber);
        color: #151515;
        font-weight: 700;
        cursor: pointer;
      }

      @media (max-width: 820px) {
        .grid,
        .settings-row {
          grid-template-columns: 1fr;
        }
      }
    </style>
  </head>
  <body>
    <div class="page">
      <nav>
        <a class="nav-brand">API Tool</a>
        <a href="/">Home</a>
        <a href="/api">Text To Video</a>
        <a href="/api/gemini">Gemini</a>
        <a href="/api/imageToVideo">Image To Video</a>
        <a href="/api/IngredientsToVideo">Ingredients To Video</a>
        <a href="/api/textToImage">Text To Image</a>
        <a href="/api/timeslapImage" class="active">Timeslap Image</a>
        <a href="/api/clone-channel">Clone YouTube</a>
      </nav>

      <section class="hero">
        <h1>Timeslap Image</h1>
        <p>Nhap 1 cau lenh cho 1 case anh. He thong se tao toi da <%= maxImages %> anh theo cung case do.</p>
      </section>

      <form id="timeslapForm" action="/api/timeslapImage" method="POST" enctype="multipart/form-data">
        <div class="grid">
          <div>
            <div class="form-group">
              <label for="initialImage">Anh 1</label>
              <div class="image-dropzone" id="imageDropzone">
                <input id="initialImage" name="initialImage" type="file" accept="image/*" required />
                <div class="image-preview" id="imagePreview">
                  <span class="material-symbols-outlined">add_photo_alternate</span>
                  <img id="imagePreviewImg" alt="Anh 1 preview" />
                </div>
                <div>
                  <p class="image-drop-title" id="imageDropTitle">Keo tha anh vao day</p>
                  <p class="image-drop-meta" id="imageDropMeta">
                    Hoac click de chon anh 1. Ho tro JPG, PNG, WEBP.
                  </p>
                  <div class="image-actions">
                    <button type="button" class="image-action-btn" id="pickImageBtn">Chon anh</button>
                    <button type="button" class="image-action-btn secondary" id="clearImageBtn">Xoa anh</button>
                  </div>
                </div>
              </div>
              <small>Day la anh goc dau tien. Agent se dung anh nay de render anh 2.</small>
            </div>

            <div class="form-group">
              <label for="prompt">Cau lenh / Prompt cho 1 case anh</label>
              <textarea
                id="prompt"
                name="prompt"
                rows="8"
                placeholder="Vi du: Continue this same landscape as a time-lapse sequence, keep the same camera angle and location, advance the time naturally, cinematic realistic detail"
                required
              ></textarea>
              <small>Mot prompt duy nhat se duoc dung lap lai: anh 1 -> anh 2, anh 1+2 -> anh 3, ... den so luong da chon.</small>
            </div>
          </div>

          <aside class="preview-card">
            <h2>Gioi han</h2>
            <ul class="preview-list">
              <li>Bat dau tu anh 1 ban upload.</li>
              <li>Tong so anh toi da: <%= maxImages %> bao gom anh 1.</li>
              <li>Neu chon 10 anh, agent se render them 9 anh moi.</li>
            </ul>
          </aside>
        </div>

        <div class="settings-row">
          <div>
            <label>So luong anh</label>
            <select name="imageCount" class="custom-select">
              <% for (let i = 1; i <= maxImages; i++) { %>
                <option value="<%= i %>" <%= i === 5 ? 'selected' : '' %>><%= i %> anh</option>
              <% } %>
            </select>
          </div>

          <div>
            <label>Ti le khung hinh</label>
            <select name="aspectRatio" class="custom-select">
              <option value="16:9" selected>Ngang</option>
              <option value="9:16">Doc</option>
              <option value="1:1">Vuong</option>
            </select>
          </div>

          <div>
            <label>Model</label>
            <select name="modelType" class="custom-select">
              <option value="Nano Banana Pro" selected>Nano Banana Pro</option>
              <option value="Nano Banana 2">Nano Banana 2</option>
              <option value="Imagen 4">Imagen 4</option>
            </select>
          </div>
        </div>

        <div class="footer">
          <button type="submit">
            <span class="material-symbols-outlined">auto_awesome_motion</span>
            Tao Timeslap
          </button>
        </div>
      </form>
    </div>
    <script>
      const form = document.getElementById("timeslapForm");
      const dropzone = document.getElementById("imageDropzone");
      const fileInput = document.getElementById("initialImage");
      const preview = document.getElementById("imagePreview");
      const previewImg = document.getElementById("imagePreviewImg");
      const title = document.getElementById("imageDropTitle");
      const meta = document.getElementById("imageDropMeta");
      const pickBtn = document.getElementById("pickImageBtn");
      const clearBtn = document.getElementById("clearImageBtn");

      function formatSize(bytes) {
        if (!bytes) return "0 KB";
        const mb = bytes / (1024 * 1024);
        if (mb >= 1) return `${mb.toFixed(2)} MB`;
        return `${Math.ceil(bytes / 1024)} KB`;
      }

      function setSelectedFile(file) {
        if (!file || !file.type.startsWith("image/")) {
          alert("Vui long chon file anh hop le.");
          return;
        }

        const dt = new DataTransfer();
        dt.items.add(file);
        fileInput.files = dt.files;

        preview.classList.add("has-image");
        previewImg.src = URL.createObjectURL(file);
        title.textContent = file.name;
        meta.textContent = `${formatSize(file.size)} | Anh 1 da san sang`;
      }

      function clearSelectedFile() {
        fileInput.value = "";
        preview.classList.remove("has-image");
        previewImg.removeAttribute("src");
        title.textContent = "Keo tha anh vao day";
        meta.textContent = "Hoac click de chon anh 1. Ho tro JPG, PNG, WEBP.";
      }

      dropzone.addEventListener("click", () => fileInput.click());
      pickBtn.addEventListener("click", (event) => {
        event.stopPropagation();
        fileInput.click();
      });
      clearBtn.addEventListener("click", (event) => {
        event.stopPropagation();
        clearSelectedFile();
      });

      fileInput.addEventListener("change", () => {
        setSelectedFile(fileInput.files[0]);
      });

      dropzone.addEventListener("dragover", (event) => {
        event.preventDefault();
        dropzone.classList.add("drag-over");
      });

      ["dragleave", "drop"].forEach((type) => {
        dropzone.addEventListener(type, () => dropzone.classList.remove("drag-over"));
      });

      dropzone.addEventListener("drop", (event) => {
        event.preventDefault();
        setSelectedFile(event.dataTransfer.files[0]);
      });

      form.addEventListener("submit", (event) => {
        const count = Number(document.querySelector('[name="imageCount"]').value || 1);
        if (!Number.isInteger(count) || count < 1 || count > <%= maxImages %>) {
          event.preventDefault();
          alert("So luong anh phai tu 1 den <%= maxImages %>.");
          return;
        }

        if (!fileInput.files.length) {
          event.preventDefault();
          alert("Vui long chon anh 1.");
        }
      });
    </script>
  </body>
</html>
