<!DOCTYPE html>
<html lang="vi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Google Flow - Ingredients</title>
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20,400,0,0"
    />
    <style>
      :root {
        --bg-dark: #1a1c1e;
        --card-bg: #212429;
        --border-color: #3f444c;
        --text-main: #e2e2e2;
        --text-dim: #9aa0a6;
        --accent-blue: #4d94ff;
      }

      body {
        background-color: var(--bg-dark);
        color: var(--text-main);
        font-family: "Segoe UI", Roboto, sans-serif;
        padding: 40px;
        margin: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        box-sizing: border-box;
      }

      .container {
        max-width: 600px;
        width: 100%;
      }

      .container-fluid {
        max-width: 850px;
        width: 100%;
        box-sizing: border-box;
      }

      .list-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
        padding: 0 10px;
        width: 100%;
      }
      .btn-clear {
        background: none;
        border: none;
        color: #ff6b6b;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 5px;
        font-size: 13px;
      }

      /* Khối Ingredient chính */
      .ingredient-card {
        background-color: var(--card-bg);
        border: 1px solid var(--border-color);
        border-radius: 12px;
        padding: 20px;
        margin-bottom: 16px;
        position: relative;
      }

      .card-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 15px;
      }

      .card-title {
        font-size: 14px;
        font-weight: 600;
        color: #fff;
      }

      .header-icons {
        display: flex;
        gap: 10px;
        color: var(--text-dim);
      }

      .btn-icon {
        cursor: pointer;
        font-size: 18px !important;
      }

      .btn-icon:hover {
        color: #fff;
      }

      /* Vùng upload ảnh */
      .upload-row {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 12px;
        margin-bottom: 15px;
      }

      .upload-box {
        position: relative; /* Bắt buộc để ảnh preview đè lên */
        aspect-ratio: 16 / 9; /* Đổi thành tỷ lệ 16:9 cho Landscape */
        overflow: hidden; /* Để ảnh không tràn góc bo tròn */
        border: 1px dashed var(--border-color);
        border-radius: 8px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        color: var(--text-dim);
        cursor: pointer;
        font-size: 12px;
        transition: 0.2s;
      }
      .preview-img {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        object-fit: cover; /* Để ảnh phủ kín box */
        border-radius: 8px;
        z-index: 10; /* Để ảnh đè lên trên icon/chữ */
      }

      .upload-box:hover {
        border-color: var(--accent-blue);
        background: rgba(77, 148, 255, 0.05);
      }

      .upload-box img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        border-radius: 8px;
      }

      /* Textarea nhập prompt */
      .prompt-box {
        width: 100%;
        background-color: transparent;
        border: 1px solid var(--border-color);
        border-radius: 8px;
        padding: 12px;
        color: var(--text-main);
        font-size: 13px;
        resize: none;
        box-sizing: border-box;
        outline: none;
      }

      /* Nút thêm Ingredient */
      .btn-add-wrapper {
        border: 1px dashed var(--border-color);
        border-radius: 12px;
        padding: 30px;
        text-align: center;
        cursor: pointer;
        color: var(--text-dim);
        transition: 0.2s;
      }

      .btn-add-wrapper:hover {
        border-color: var(--accent-blue);
        color: #fff;
      }

      .footer {
        margin-top: 40px;
        display: flex;
        justify-content: flex-end;
      }
      .btn-submit {
        background: var(--accent-blue);
        color: white;
        border: none;
        width: 45px;
        height: 45px;
        border-radius: 50%;
        cursor: pointer;
      }
      nav {
        width: 100%;
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 40px;
        flex-wrap: wrap;
      }

      .nav-brand {
        font-size: 18px;
        font-weight: bold;
        color: white;
        text-decoration: none;
        margin-right: 16px;
      }

      nav a {
        text-decoration: none;
        color: var(--text-dim);
        font-size: 14px;
        padding: 6px 12px;
        border-radius: 20px;
        border: 1px solid transparent;
        transition: all 0.2s;
      }

      nav a:hover {
        color: var(--text-main);
        border-color: var(--border-color);
      }

      nav a.active {
        color: var(--accent-blue);
        border-color: var(--accent-blue);
      }
      /* Cấu hình layout cho hàng cài đặt */
      .settings-row {
        display: flex;
        gap: 20px;
        margin-top: 20px;
        margin-bottom: 20px;
        padding: 0 10px;
        align-items: flex-end;
      }

      .setting-group {
        display: flex;
        flex-direction: column;
        gap: 8px;
      }

      .setting-label {
        font-size: 13px;
        color: var(--text-dim, #9aa0a6);
      }

      /* Wrapper để tuỳ chỉnh mũi tên của Select */
      .select-wrapper {
        position: relative;
        display: inline-block;
      }
      .custom-select {
        appearance: none; /* Ẩn mũi tên mặc định của trình duyệt */
        -webkit-appearance: none;
        -moz-appearance: none;
        background-color: var(--card-bg, #1e2124);
        color: var(--text-main, #e2e2e2);
        border: 1px solid var(--border-color, #33373b);
        border-radius: 6px;
        padding: 10px 36px 10px 12px;
        font-size: 14px;
        font-family: inherit;
        cursor: pointer;
        outline: none;
        transition: border-color 0.2s ease;
        min-width: 140px;
      }

      /* Hiệu ứng viền màu xanh ngọc khi được chọn giống ảnh */
      .custom-select:focus,
      .custom-select:active {
        border-color: #00bfa5; /* Màu xanh ngọc của Veo */
      }

      /* Tạo lại mũi tên thả xuống (Dropdown Arrow) */
      .select-wrapper::after {
        content: "expand_more";
        font-family: "Material Symbols Outlined";
        position: absolute;
        right: 10px;
        top: 50%;
        transform: translateY(-50%);
        color: var(--text-dim, #9aa0a6);
        pointer-events: none; /* Để click không bị vướng */
        font-size: 18px;
      }

      /* Style cho các tuỳ chọn (Option) khi xổ xuống */
      .custom-select option {
        background-color: var(--card-bg, #1e2124);
        color: var(--text-main, #e2e2e2);
        padding: 10px;
      }

      /* ===== DROP ZONE ===== */
      .drop-zone {
        border: 2px dashed var(--border-color);
        border-radius: 12px;
        padding: 16px;
        margin-bottom: 16px;
        transition:
          border-color 0.2s,
          background 0.2s;
      }
      .drop-zone.drag-over {
        border-color: var(--accent-blue);
        background: rgba(77, 148, 255, 0.05);
      }
      .drop-area {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 8px;
        padding: 12px;
        color: var(--text-dim);
        font-size: 13px;
      }
      .drop-area p {
        margin: 0;
      }
      .btn-browse {
        background: none;
        border: 1px solid var(--border-color);
        color: var(--text-main);
        padding: 6px 16px;
        border-radius: 20px;
        cursor: pointer;
        font-size: 13px;
        margin-top: 4px;
      }
      .btn-browse:hover {
        background: #2a2e34;
      }
      .drop-preview {
        display: flex;
        flex-direction: column;
        gap: 12px;
      }
      .drop-preview-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        font-size: 13px;
        color: var(--text-dim);
      }
      .btn-add-more-drop {
        background: none;
        border: 1px solid var(--border-color);
        color: var(--text-dim);
        padding: 3px 10px;
        border-radius: 12px;
        font-size: 12px;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 4px;
      }
      .btn-add-more-drop:hover {
        background: #2a2e34;
      }
      .drop-thumbs {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        max-height: 160px;
        overflow-y: auto;
      }
      .drop-thumb-item {
        position: relative;
        flex-shrink: 0;
      }
      .drop-thumb-item img {
        width: 88px;
        height: 54px;
        object-fit: cover;
        border-radius: 6px;
        border: 1px solid var(--border-color);
        display: block;
      }
      .drop-thumb-item .thumb-order {
        position: absolute;
        bottom: 3px;
        left: 4px;
        background: rgba(0, 0, 0, 0.65);
        color: #fff;
        font-size: 10px;
        padding: 1px 4px;
        border-radius: 4px;
        pointer-events: none;
      }
      .drop-thumb-item .remove-thumb {
        position: absolute;
        top: -5px;
        right: -5px;
        width: 17px;
        height: 17px;
        background: #e53935;
        border-radius: 50%;
        border: none;
        color: #fff;
        font-size: 11px;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 0;
      }
      .drop-config {
        display: flex;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
      }
      .drop-config label {
        font-size: 13px;
        color: var(--text-dim);
        white-space: nowrap;
      }
      .per-ing-btns {
        display: flex;
        gap: 6px;
      }
      .per-ing-btn {
        background: none;
        border: 1px solid var(--border-color);
        color: var(--text-dim);
        width: 34px;
        height: 34px;
        border-radius: 8px;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.15s;
      }
      .per-ing-btn:hover {
        background: #2a2e34;
      }
      .per-ing-btn.active {
        border-color: var(--accent-blue);
        color: var(--accent-blue);
        background: rgba(77, 148, 255, 0.1);
      }
      .drop-hint {
        font-size: 12px;
        color: var(--text-dim);
        margin-left: auto;
      }
      .drop-actions {
        display: flex;
        gap: 10px;
        align-items: center;
        flex-wrap: wrap;
      }
      .btn-apply-drop {
        background: var(--accent-blue);
        border: none;
        color: #fff;
        padding: 8px 20px;
        border-radius: 8px;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 6px;
        font-size: 13px;
        font-family: inherit;
      }
      .btn-apply-drop:hover {
        background: #3a7fe0;
      }
      .btn-clear-drop {
        background: none;
        border: 1px solid var(--border-color);
        color: var(--text-dim);
        padding: 8px 16px;
        border-radius: 8px;
        cursor: pointer;
        font-size: 13px;
      }
      .btn-clear-drop:hover {
        background: #2a2e34;
      }
      /* ===== END DROP ZONE ===== */

      @media (max-width: 640px) {
        body {
          padding: 12px;
        }

        .container-fluid {
          padding: 0;
        }

        .upload-row {
          grid-template-columns: repeat(2, 1fr);
        }

        .settings-row {
          flex-wrap: wrap;
          gap: 12px;
          padding: 0;
        }

        .custom-select {
          min-width: unset;
          width: 100%;
        }

        .ingredient-card {
          padding: 14px;
        }

        .list-header {
          flex-wrap: wrap;
          gap: 10px;
          padding: 0;
        }

        .prompt-box {
          font-size: 14px;
        }
      }
    </style>
  </head>
  <body>
    <div class="container-fluid">
      <nav>
        <a class="nav-brand">API Tool</a>
        <a href="/">Home</a>
        <a href="/api">Text To Video</a>
        <a href="/api/gemini">Gemini</a>
        <a href="/api/imageToVideo">Image To Video</a>
        <a href="/api/IngredientsToVideo" class="active"
          >Ingredients To Video</a
        >
        <a href="/api/clone-channel">Clone YouTube</a>
        <a href="/api/textToImage">Text To Image</a>
      </nav>

      <form
        id="renderForm"
        action="/api/IngredientsToVideo"
        method="POST"
        enctype="multipart/form-data"
      >
        <div class="list-header">
          <span style="font-size: 14px; color: var(--text-dim)"
            >Cấu hình luồng Ingredients</span
          >
          <button
            type="button"
            class="btn-clear"
            onclick="clearAllIngredients()"
          >
            <span class="material-symbols-outlined" style="font-size: 18px"
              >delete_sweep</span
            >
            Xóa tất cả
          </button>
        </div>

        <!-- ===== DROP ZONE ===== -->
        <div id="dropZone" class="drop-zone">
          <div class="drop-area" id="dropArea">
            <span class="material-symbols-outlined" style="font-size: 36px"
              >burst_mode</span
            >
            <p>Kéo thả nhiều ảnh để tự động tạo Ingredients</p>
            <input
              type="file"
              id="dropFileInput"
              multiple
              accept="image/*"
              style="display: none"
              onchange="handleDropFileSelect(this)"
            />
            <button
              type="button"
              class="btn-browse"
              onclick="document.getElementById('dropFileInput').click()"
            >
              Chọn ảnh
            </button>
          </div>

          <div class="drop-preview" id="dropPreview" style="display: none">
            <div class="drop-preview-header">
              <span id="dropCountLabel">0 ảnh</span>
              <button
                type="button"
                class="btn-add-more-drop"
                onclick="document.getElementById('dropFileInputMore').click()"
              >
                <span class="material-symbols-outlined" style="font-size: 14px"
                  >add</span
                >
                Thêm ảnh
              </button>
              <input
                type="file"
                id="dropFileInputMore"
                multiple
                accept="image/*"
                style="display: none"
                onchange="handleDropFileSelect(this)"
              />
            </div>

            <div class="drop-thumbs" id="dropThumbs"></div>

            <div class="drop-config">
              <label>Ảnh mỗi ingredient:</label>
              <div class="per-ing-btns">
                <button
                  type="button"
                  class="per-ing-btn"
                  data-n="1"
                  onclick="setPerIngredient(1)"
                >
                  1
                </button>
                <button
                  type="button"
                  class="per-ing-btn"
                  data-n="2"
                  onclick="setPerIngredient(2)"
                >
                  2
                </button>
                <button
                  type="button"
                  class="per-ing-btn active"
                  data-n="3"
                  onclick="setPerIngredient(3)"
                >
                  3
                </button>
              </div>
              <span class="drop-hint" id="dropHint"></span>
            </div>

            <div class="drop-actions">
              <button
                type="button"
                class="btn-apply-drop"
                id="btnApplyDrop"
                onclick="applyDropped()"
              >
                <span class="material-symbols-outlined" style="font-size: 16px"
                  >auto_fix_high</span
                >
                Tạo Ingredients
              </button>
              <button
                type="button"
                class="btn-clear-drop"
                onclick="clearDropped()"
              >
                Xóa ảnh
              </button>
            </div>
          </div>
        </div>
        <!-- ===== END DROP ZONE ===== -->

        <div id="ingredientList">
          <div class="ingredient-card">
            <div class="card-header">
              <span class="card-title">Ingredient 1</span>
              <div class="header-icons">
                <span
                  class="material-symbols-outlined btn-icon btn-delete"
                  onclick="removeIngredient(this)"
                  >close</span
                >
              </div>
            </div>

            <div class="upload-row">
              <div
                class="upload-box"
                onclick="this.querySelector('input').click()"
              >
                <span class="material-symbols-outlined">upload</span>
                <span>Upload</span>
                <input
                  type="file"
                  name="images_1[]"
                  hidden
                  onchange="handlePreview(this)"
                />
              </div>
              <div
                class="upload-box"
                onclick="this.querySelector('input').click()"
              >
                <span class="material-symbols-outlined">upload</span>
                <span>Upload</span>
                <input
                  type="file"
                  name="images_1[]"
                  hidden
                  onchange="handlePreview(this)"
                />
              </div>
              <div
                class="upload-box"
                onclick="this.querySelector('input').click()"
              >
                <span class="material-symbols-outlined">upload</span>
                <span>Upload</span>
                <input
                  type="file"
                  name="images_1[]"
                  hidden
                  onchange="handlePreview(this)"
                />
              </div>
            </div>

            <textarea
              name="prompts[]"
              class="prompt-box"
              rows="3"
              placeholder="Nhập prompt cho ingredient này..."
            ></textarea>
          </div>
        </div>

        <div class="btn-add-wrapper" onclick="addIngredient()">
          <span
            class="material-symbols-outlined"
            style="font-size: 32px; display: block; margin-bottom: 10px"
            >add</span
          >
          <span>Thêm Ingredient</span>
        </div>

        <div class="footer">
          <button type="submit" class="btn-submit">
            <span class="material-symbols-outlined">arrow_forward</span>
          </button>
        </div>
        <div class="settings-row">
          <div class="setting-group">
            <label class="setting-label">Tỉ lệ khung hình:</label>
            <div class="select-wrapper">
              <select name="aspectRatio" class="custom-select">
                <option value="16:9" selected>Ngang</option>
                <option value="9:16">Dọc</option>
              </select>
            </div>
          </div>

          <div class="setting-group">
            <label class="setting-label">Model:</label>
            <div class="select-wrapper">
              <select name="modelType" class="custom-select">
                <option value="Veo 3.1 - Lite [Lower Priority]" selected>Veo 3.1 - Lite [Lower Priority]</option>
                <option value="Veo 3.1 - Fast [Lower Priority] (leaving 5/10)">Veo 3.1 - Fast [Lower Priority] (leaving 5/10)</option>
                <option value="Veo 3.1 - Lite">Veo 3.1 - Lite</option>
                <option value="Veo 3.1 - Fast">Veo 3.1 - Fast</option>
                <option value="Veo 3.1 - Quality">Veo 3.1 - Quality</option>
              </select>
            </div>
          </div>

          <div class="setting-group">
            <label class="setting-label">Số lượng:</label>
            <div class="select-wrapper">
              <select name="renderCount" class="custom-select">
                <option value="x1" selected>1x</option>
                <option value="x2">2x</option>
                <option value="x3">3x</option>
                <option value="x4">4x</option>
              </select>
            </div>
          </div>
        </div>
      </form>
    </div>

    <script>
      let count = 1;

      // Validate form trước khi gửi
      document
        .getElementById("renderForm")
        .addEventListener("submit", function (e) {
          const cards = document.querySelectorAll(".ingredient-card");
          let hasData = false;

          cards.forEach((card) => {
            const prompt = card.querySelector("textarea").value.trim();
            const files = [...card.querySelectorAll('input[type="file"]')].some(
              (inp) => inp.files.length > 0,
            );
            if (prompt || files) hasData = true;
          });

          if (!hasData) {
            e.preventDefault();
            alert(
              "Không có task hợp lệ! Vui lòng nhập prompt hoặc tải ảnh lên.",
            );
          }
        });

      function addIngredient() {
        count++;
        const list = document.getElementById("ingredientList");
        const newCard = document.createElement("div");
        newCard.className = "ingredient-card";
        newCard.innerHTML = `
                <div class="card-header">
                    <span class="card-title">Ingredient ${count}</span>
                    <div class="header-icons">
                        <span class="material-symbols-outlined btn-icon" onclick="removeIngredient(this)">close</span>
                    </div>
                </div>
                <div class="upload-row">
                    ${Array(3)
                      .fill(
                        `<div class="upload-box" onclick="this.querySelector('input').click()">
                        <span class="material-symbols-outlined">upload</span>
                        <span>Upload</span>
                        <input type="file" name="images_${count}[]" hidden onchange="handlePreview(this)">
                    </div>`,
                      )
                      .join("")}
                </div>
                <textarea name="prompts[]" class="prompt-box" rows="3" placeholder="Nhập prompt cho ingredient này..."></textarea>
            `;
        list.appendChild(newCard);
      }

      function removeIngredient(btn) {
        const cards = document.querySelectorAll(".ingredient-card");
        if (cards.length > 1) {
          btn.closest(".ingredient-card").remove();
          reindexIngredients(); // Quan trọng: Đánh số lại sau khi xóa
        } else {
          alert("Phải có ít nhất một Ingredient!");
        }
      }

      function clearAllIngredients() {
        // Xóa tất cả các card phụ (extra cards)
        const list = document.getElementById("ingredientList");
        const cards = list.querySelectorAll(".ingredient-card");
        for (let i = 1; i < cards.length; i++) {
          cards[i].remove();
        }

        // Reset card đầu tiên về trạng thái mặc định
        const firstCard = cards[0];
        if (firstCard) {
          // Xóa các ảnh preview
          firstCard
            .querySelectorAll(".preview-img")
            .forEach((img) => img.remove());

          // Hiện lại các icon upload ban đầu
          firstCard
            .querySelectorAll(".upload-box span")
            .forEach((s) => (s.style.visibility = "visible"));

          // Reset các input file và style của chúng
          firstCard.querySelectorAll('input[type="file"]').forEach((input) => {
            input.value = "";
            input.style.position = "";
            input.style.opacity = "";
            input.style.zIndex = "";
          });

          // Xóa prompt
          const prompt = firstCard.querySelector("textarea");
          if (prompt) prompt.value = "";
        }

        // Reset biến đếm và dọn sạch drop zone
        count = 1;
        if (typeof clearDropped === "function") clearDropped();
        reindexIngredients();
      }

      function reindexIngredients() {
        const cards = document.querySelectorAll(".ingredient-card");
        cards.forEach((card, index) => {
          const displayIndex = index + 1;
          // Cập nhật tiêu đề hiển thị (Ingredient 1, 2, 3...)
          const title = card.querySelector(".card-title");
          title.innerText = `Ingredient ${displayIndex}`;

          // Cập nhật thuộc tính name của các input file nếu bạn cần phân biệt theo dòng
          // Nếu dùng images[] chung cho tất cả thì không cần bước này,
          // nhưng nếu muốn phân tách theo cụm thì dùng:
          const inputs = card.querySelectorAll('input[type="file"]');
          inputs.forEach((input) => {
            input.name = `images_${displayIndex}[]`;
          });
        });
      }
      // ===== DROP ZONE LOGIC =====
      let droppedFiles = [];
      let perIngredient = 3;

      const dropZoneEl = document.getElementById("dropZone");
      dropZoneEl.addEventListener("dragover", (e) => {
        e.preventDefault();
        dropZoneEl.classList.add("drag-over");
      });
      dropZoneEl.addEventListener("dragleave", (e) => {
        if (!dropZoneEl.contains(e.relatedTarget))
          dropZoneEl.classList.remove("drag-over");
      });
      dropZoneEl.addEventListener("drop", (e) => {
        e.preventDefault();
        dropZoneEl.classList.remove("drag-over");
        const files = [...e.dataTransfer.files].filter((f) =>
          f.type.startsWith("image/"),
        );
        if (files.length) {
          droppedFiles.push(...files);
          renderDropped();
        }
      });

      function handleDropFileSelect(input) {
        const files = [...input.files].filter((f) =>
          f.type.startsWith("image/"),
        );
        if (files.length) {
          droppedFiles.push(...files);
          renderDropped();
        }
        input.value = "";
      }

      function setPerIngredient(n) {
        perIngredient = n;
        document.querySelectorAll(".per-ing-btn").forEach((btn) => {
          btn.classList.toggle("active", parseInt(btn.dataset.n) === n);
        });
        updateDropHint();
      }

      function updateDropHint() {
        const total = droppedFiles.length;
        const ingCount = Math.ceil(total / perIngredient);
        document.getElementById("dropHint").textContent =
          total > 0
            ? `→ ${ingCount} ingredient${ingCount !== 1 ? "s" : ""}`
            : "";
        const btn = document.getElementById("btnApplyDrop");
        btn.innerHTML = `<span class="material-symbols-outlined" style="font-size:16px">auto_fix_high</span> Tạo ${ingCount} Ingredient${ingCount !== 1 ? "s" : ""}`;
      }

      function renderDropped() {
        const previewDiv = document.getElementById("dropPreview");
        const dropAreaEl = document.getElementById("dropArea");
        const thumbsDiv = document.getElementById("dropThumbs");
        const countLabel = document.getElementById("dropCountLabel");

        if (droppedFiles.length === 0) {
          previewDiv.style.display = "none";
          dropAreaEl.style.display = "flex";
          return;
        }
        previewDiv.style.display = "flex";
        dropAreaEl.style.display = "none";
        countLabel.textContent = `${droppedFiles.length} ảnh`;

        thumbsDiv.innerHTML = "";
        droppedFiles.forEach((file, i) => {
          const url = URL.createObjectURL(file);
          const item = document.createElement("div");
          item.className = "drop-thumb-item";
          item.innerHTML = `
            <img src="${url}" title="${file.name}" />
            <span class="thumb-order">${i + 1}</span>
            <button class="remove-thumb" type="button" onclick="removeDroppedFile(${i})">×</button>
          `;
          thumbsDiv.appendChild(item);
        });
        updateDropHint();
      }

      function removeDroppedFile(idx) {
        droppedFiles.splice(idx, 1);
        renderDropped();
      }

      function clearDropped() {
        droppedFiles = [];
        renderDropped();
      }

      function applyDropped() {
        if (droppedFiles.length === 0) return;

        // Chia files thành từng nhóm theo perIngredient
        const chunks = [];
        for (let i = 0; i < droppedFiles.length; i += perIngredient) {
          chunks.push(droppedFiles.slice(i, i + perIngredient));
        }

        // Lấy các card rỗng (chưa có file nào)
        const emptyCards = [
          ...document.querySelectorAll(".ingredient-card"),
        ].filter((card) => {
          const inputs = card.querySelectorAll('input[type="file"]');
          return [...inputs].every((inp) => inp.files.length === 0);
        });

        let emptyIdx = 0;
        for (const chunk of chunks) {
          let card;
          if (emptyIdx < emptyCards.length) {
            card = emptyCards[emptyIdx++];
          } else {
            addIngredient();
            const all = document.querySelectorAll(".ingredient-card");
            card = all[all.length - 1];
          }
          fillIngredientCard(card, chunk);
        }

        clearDropped();
      }

      function fillIngredientCard(card, files) {
        const boxes = card.querySelectorAll(".upload-box");
        files.forEach((file, i) => {
          if (i >= boxes.length) return;
          const box = boxes[i];
          const input = box.querySelector('input[type="file"]');
          // Gán file vào input
          const dt = new DataTransfer();
          dt.items.add(file);
          input.files = dt.files;
          // Hiển thị preview
          previewFileInBox(box, file);
        });
      }

      function previewFileInBox(box, file) {
        const reader = new FileReader();
        reader.onload = (e) => {
          let img = box.querySelector(".preview-img");
          if (!img) {
            img = document.createElement("img");
            img.className = "preview-img";
            box.appendChild(img);
          }
          img.src = e.target.result;
          box
            .querySelectorAll("span")
            .forEach((s) => (s.style.visibility = "hidden"));
          const input = box.querySelector("input");
          if (input) {
            input.style.position = "absolute";
            input.style.opacity = "0";
            input.style.zIndex = "11";
          }
        };
        reader.readAsDataURL(file);
      }
      // ===== END DROP ZONE LOGIC =====

      function handlePreview(input) {
        if (input.files && input.files[0]) {
          const reader = new FileReader();
          const box = input.parentElement; // Đây là thẻ .upload-box

          reader.onload = function (e) {
            // 1. Kiểm tra xem đã có thẻ img preview chưa, nếu chưa thì tạo mới
            let img = box.querySelector(".preview-img");
            if (!img) {
              img = document.createElement("img");
              img.className = "preview-img";
              box.appendChild(img);
            }

            // 2. Gán dữ liệu ảnh vào thẻ img
            img.src = e.target.result;

            // 3. Ẩn các icon và chữ "Upload" hiện có
            box.querySelectorAll("span").forEach((span) => {
              span.style.visibility = "hidden"; // Dùng visibility:hidden để giữ nguyên layout
            });

            // 4. Quan trọng nhất: Giữ nguyên thẻ input nhưng ẩn nó đi
            // Đừng xóa nó, đừng thay đổi innerHTML của box
            // Thẻ input vẫn nằm đó để gửi file lên server
            input.style.position = "absolute";
            input.style.opacity = "0";
            input.style.zIndex = "11"; // Để người dùng vẫn có thể click lại nếu muốn đổi ảnh
          };

          reader.readAsDataURL(input.files[0]);
        }
      }
    </script>
  </body>
</html>
