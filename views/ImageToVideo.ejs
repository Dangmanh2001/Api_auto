<!DOCTYPE html>
<html lang="vi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Google Flow - Frame Management</title>
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20,400,0,0"
    />
    <style>
      :root {
        --bg-dark: #1a1c1e;
        --card-bg: #212429;
        --border-color: #3f444c;
        --text-main: #e2e2e2;
        --text-dim: #9aa0a6;
        --accent-blue: #4d94ff;
      }

      body {
        background-color: var(--bg-dark);
        color: var(--text-main);
        font-family: "Segoe UI", Roboto, sans-serif;
        padding: 40px;
        display: flex;
        justify-content: center;
        box-sizing: border-box;
      }

      .container {
        max-width: 850px;
        width: 100%;
      }

      .bulk-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
        padding: 0 10px;
      }

      .header-controls {
        display: flex;
        gap: 20px;
        align-items: center;
      }

      .btn-toggle-end {
        background: none;
        border: 1px solid var(--border-color);
        color: var(--text-main);
        padding: 5px 12px;
        border-radius: 20px;
        font-size: 12px;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 6px;
      }

      .btn-toggle-end:hover {
        background: #333;
      }

      .btn-clear {
        background: none;
        border: none;
        color: #ff6b6b;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 5px;
        font-size: 13px;
      }

      #flowList {
        display: flex;
        flex-direction: column;
        gap: 20px;
      }

      .frame-group {
        background-color: var(--card-bg);
        border: 1px solid var(--border-color);
        border-radius: 16px;
        padding: 20px;
        position: relative;
        display: flex;
        flex-direction: column;
        gap: 15px;
      }

      .images-container {
        display: flex;
        align-items: center;
        gap: 15px;
      }

      .image-box {
        display: flex;
        flex-direction: column;
        gap: 8px;
      }
      .image-box span {
        font-size: 11px;
        color: var(--text-dim);
      }

      .thumbnail {
        width: 120px;
        height: 70px;
        border-radius: 8px;
        object-fit: cover;
        border: 1px solid var(--border-color);
        background: #000;
      }

      .arrow-sep {
        color: var(--text-dim);
      }

      .prompt-area {
        flex-grow: 1;
        background: #131517;
        border: 1px solid var(--border-color);
        border-radius: 12px;
        padding: 12px;
        height: 70px;
        color: #fff;
        font-size: 14px;
        resize: none;
      }

      .btn-delete {
        position: absolute;
        top: 15px;
        right: 15px;
        background: none;
        border: none;
        color: var(--text-dim);
        cursor: pointer;
      }

      /* LOGIC ẨN END FRAME */
      .hide-end .end-frame-box,
      .hide-end .arrow-sep {
        display: none !important;
      }

      .add-row {
        display: flex;
        justify-content: center;
        margin-top: 30px;
      }
      .btn-add-frame {
        width: 50px;
        height: 50px;
        border-radius: 50%;
        border: 2px dashed var(--border-color);
        background: none;
        color: var(--text-dim);
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
      }

      .footer {
        margin-top: 40px;
        display: flex;
        justify-content: flex-end;
      }
      .btn-submit {
        background: var(--accent-blue);
        color: white;
        border: none;
        width: 45px;
        height: 45px;
        border-radius: 50%;
        cursor: pointer;
      }
      /* Cấu hình layout cho hàng cài đặt */
      .settings-row {
        display: flex;
        gap: 20px;
        margin-top: 20px;
        margin-bottom: 20px;
        padding: 0 10px;
        align-items: flex-end;
      }

      .setting-group {
        display: flex;
        flex-direction: column;
        gap: 8px;
      }

      .setting-label {
        font-size: 13px;
        color: var(--text-dim, #9aa0a6);
      }

      /* Wrapper để tuỳ chỉnh mũi tên của Select */
      .select-wrapper {
        position: relative;
        display: inline-block;
      }

      /* Định dạng cho ô Select */
      .custom-select {
        appearance: none; /* Ẩn mũi tên mặc định của trình duyệt */
        -webkit-appearance: none;
        -moz-appearance: none;
        background-color: var(--card-bg, #1e2124);
        color: var(--text-main, #e2e2e2);
        border: 1px solid var(--border-color, #33373b);
        border-radius: 6px;
        padding: 10px 36px 10px 12px;
        font-size: 14px;
        font-family: inherit;
        cursor: pointer;
        outline: none;
        transition: border-color 0.2s ease;
        min-width: 140px;
      }

      /* Hiệu ứng viền màu xanh ngọc khi được chọn giống ảnh */
      .custom-select:focus,
      .custom-select:active {
        border-color: #00bfa5; /* Màu xanh ngọc của Veo */
      }

      /* Tạo lại mũi tên thả xuống (Dropdown Arrow) */
      .select-wrapper::after {
        content: "expand_more";
        font-family: "Material Symbols Outlined";
        position: absolute;
        right: 10px;
        top: 50%;
        transform: translateY(-50%);
        color: var(--text-dim, #9aa0a6);
        pointer-events: none; /* Để click không bị vướng */
        font-size: 18px;
      }

      /* Style cho các tuỳ chọn (Option) khi xổ xuống */
      .custom-select option {
        background-color: var(--card-bg, #1e2124);
        color: var(--text-main, #e2e2e2);
        padding: 10px;
      }
      nav {
        width: 100%;
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 40px;
        flex-wrap: wrap;
      }

      .nav-brand {
        font-size: 18px;
        font-weight: bold;
        color: white;
        text-decoration: none;
        margin-right: 16px;
      }

      nav a {
        text-decoration: none;
        color: var(--text-dim);
        font-size: 14px;
        padding: 6px 12px;
        border-radius: 20px;
        border: 1px solid transparent;
        transition: all 0.2s;
      }

      nav a:hover {
        color: var(--text-main);
        border-color: var(--border-color);
      }

      nav a.active {
        color: var(--accent-blue);
        border-color: var(--accent-blue);
      }

      /* ===== DROP ZONE ===== */
      .drop-zone {
        margin-bottom: 20px;
        border: 2px dashed var(--border-color);
        border-radius: 16px;
        padding: 16px;
        transition:
          border-color 0.2s,
          background 0.2s;
      }
      .drop-zone.drag-over {
        border-color: var(--accent-blue);
        background: rgba(77, 148, 255, 0.06);
      }
      .drop-area {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 8px;
        padding: 12px;
        cursor: default;
        color: var(--text-dim);
        font-size: 13px;
      }
      .drop-area p {
        margin: 0;
      }
      .btn-browse {
        background: none;
        border: 1px solid var(--border-color);
        color: var(--text-main);
        padding: 6px 16px;
        border-radius: 20px;
        cursor: pointer;
        font-size: 13px;
        margin-top: 4px;
      }
      .btn-browse:hover {
        background: #333;
      }
      .drop-preview {
        display: flex;
        flex-direction: column;
        gap: 12px;
      }
      .drop-preview-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        font-size: 13px;
        color: var(--text-dim);
        padding: 0 2px;
      }
      .btn-add-more {
        background: none;
        border: 1px solid var(--border-color);
        color: var(--text-dim);
        padding: 3px 10px;
        border-radius: 12px;
        font-size: 12px;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 4px;
      }
      .btn-add-more:hover {
        background: #2a2e34;
      }
      .drop-thumbs {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        max-height: 170px;
        overflow-y: auto;
        padding: 2px;
      }
      .drop-thumb-item {
        position: relative;
        flex-shrink: 0;
      }
      .drop-thumb-item img {
        width: 88px;
        height: 54px;
        object-fit: cover;
        border-radius: 6px;
        border: 1px solid var(--border-color);
        display: block;
      }
      .drop-thumb-item .thumb-order {
        position: absolute;
        bottom: 3px;
        left: 4px;
        background: rgba(0, 0, 0, 0.65);
        color: #fff;
        font-size: 10px;
        padding: 1px 4px;
        border-radius: 4px;
        pointer-events: none;
      }
      .drop-thumb-item .remove-thumb {
        position: absolute;
        top: -5px;
        right: -5px;
        width: 17px;
        height: 17px;
        background: #e53935;
        border-radius: 50%;
        border: none;
        color: #fff;
        font-size: 11px;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        line-height: 1;
        padding: 0;
      }
      .drop-modes {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
      }
      .mode-btn {
        background: none;
        border: 1px solid var(--border-color);
        color: var(--text-dim);
        padding: 6px 14px;
        border-radius: 20px;
        font-size: 12px;
        cursor: pointer;
        transition: all 0.15s;
        display: flex;
        align-items: center;
        gap: 5px;
      }
      .mode-btn:hover {
        background: #2a2e34;
      }
      .mode-btn.active {
        border-color: var(--accent-blue);
        color: var(--accent-blue);
        background: rgba(77, 148, 255, 0.1);
      }
      .drop-actions {
        display: flex;
        gap: 10px;
        align-items: center;
        flex-wrap: wrap;
      }
      .btn-apply-drop {
        background: var(--accent-blue);
        border: none;
        color: #fff;
        padding: 8px 20px;
        border-radius: 20px;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 6px;
        font-size: 13px;
        font-family: inherit;
      }
      .btn-apply-drop:hover {
        background: #3a7fe0;
      }
      .btn-clear-drop {
        background: none;
        border: 1px solid var(--border-color);
        color: var(--text-dim);
        padding: 8px 16px;
        border-radius: 20px;
        cursor: pointer;
        font-size: 13px;
      }
      .btn-clear-drop:hover {
        background: #2a2e34;
      }
      .drop-mode-hint {
        font-size: 11px;
        color: var(--text-dim);
        margin-left: auto;
        align-self: center;
      }
      /* ===== END DROP ZONE ===== */

      @media (max-width: 640px) {
        body {
          padding: 12px;
        }

        .bulk-header {
          flex-wrap: wrap;
          gap: 10px;
          padding: 0;
        }

        .header-controls {
          flex-wrap: wrap;
          gap: 8px;
        }

        .images-container {
          flex-direction: column;
          align-items: stretch;
        }

        .arrow-sep {
          transform: rotate(90deg);
          align-self: center;
        }

        .thumbnail {
          width: 100%;
          height: auto;
          aspect-ratio: 16 / 9;
        }

        .image-box {
          width: 100%;
        }

        .prompt-area {
          width: 100%;
          box-sizing: border-box;
          height: 90px;
        }

        .settings-row {
          flex-wrap: wrap;
          gap: 12px;
          padding: 0;
        }

        .custom-select {
          min-width: unset;
          width: 100%;
        }

        .frame-group {
          padding: 14px;
        }
      }
    </style>
  </head>
  <body>
    <div id="page-root">
      <div class="container hide-end" id="mainApp">
        <nav>
          <a class="nav-brand">API Tool</a>
          <a href="/">Home</a>
          <a href="/api">Text To Video</a>
          <a href="/api/gemini">Gemini</a>
          <a href="/api/imageToVideo" class="active">Image To Video</a>
          <a href="/api/IngredientsToVideo">Ingredients To Video</a>
          <a href="/api/clone-channel">Clone YouTube</a>
          <a href="/api/textToImage">Text To Image</a>
        </nav>

        <form
          id="renderForm"
          action="/api/imageToVideo"
          method="POST"
          enctype="multipart/form-data"
        >
          <div class="bulk-header">
            <div class="header-controls">
              <span>Cấu hình luồng Flow</span>
              <button
                type="button"
                class="btn-toggle-end"
                onclick="toggleEndFrames()"
              >
                <span class="material-symbols-outlined" style="font-size: 18px"
                  >visibility_off</span
                >
                Ẩn/Hiện End Frame
              </button>
            </div>
            <button type="button" class="btn-clear" onclick="clearAll()">
              <span class="material-symbols-outlined">delete_sweep</span> Xóa
              tất cả
            </button>
          </div>

          <!-- ===== DROP ZONE ===== -->
          <div id="dropZone" class="drop-zone">
            <!-- Trạng thái rỗng: hiện hướng dẫn kéo thả -->
            <div class="drop-area" id="dropArea">
              <span class="material-symbols-outlined" style="font-size: 38px"
                >upload_file</span
              >
              <p>Kéo thả nhiều ảnh vào đây để tạo frames hàng loạt</p>
              <input
                type="file"
                id="dropFileInput"
                multiple
                accept="image/*"
                style="display: none"
                onchange="handleFileSelect(this)"
              />
              <button
                type="button"
                class="btn-browse"
                onclick="document.getElementById('dropFileInput').click()"
              >
                Chọn ảnh
              </button>
            </div>

            <!-- Trạng thái có ảnh: hiện preview + cài đặt -->
            <div class="drop-preview" id="dropPreview" style="display: none">
              <div class="drop-preview-header">
                <span id="dropCountLabel">0 ảnh</span>
                <button
                  type="button"
                  class="btn-add-more"
                  onclick="document.getElementById('dropFileInputMore').click()"
                >
                  <span
                    class="material-symbols-outlined"
                    style="font-size: 14px"
                    >add</span
                  >
                  Thêm ảnh
                </button>
                <input
                  type="file"
                  id="dropFileInputMore"
                  multiple
                  accept="image/*"
                  style="display: none"
                  onchange="handleFileSelect(this)"
                />
              </div>

              <div class="drop-thumbs" id="dropThumbs"></div>

              <!-- Chọn chế độ gán -->
              <div class="drop-modes">
                <button
                  type="button"
                  class="mode-btn active"
                  data-mode="alternate"
                  onclick="setDropMode('alternate')"
                >
                  <span
                    class="material-symbols-outlined"
                    style="font-size: 15px"
                    >swap_horiz</span
                  >
                  Xen kẽ Start → End
                </button>
                <button
                  type="button"
                  class="mode-btn"
                  data-mode="start"
                  onclick="setDropMode('start')"
                >
                  <span
                    class="material-symbols-outlined"
                    style="font-size: 15px"
                    >first_page</span
                  >
                  Chỉ Start
                </button>
                <button
                  type="button"
                  class="mode-btn"
                  data-mode="end"
                  onclick="setDropMode('end')"
                >
                  <span
                    class="material-symbols-outlined"
                    style="font-size: 15px"
                    >last_page</span
                  >
                  Chỉ End
                </button>
                <span class="drop-mode-hint" id="dropModeHint"></span>
              </div>

              <div class="drop-actions">
                <button
                  type="button"
                  class="btn-apply-drop"
                  id="btnApplyDrop"
                  onclick="applyDropped()"
                >
                  <span
                    class="material-symbols-outlined"
                    style="font-size: 16px"
                    >auto_fix_high</span
                  >
                  Tạo frames
                </button>
                <button
                  type="button"
                  class="btn-clear-drop"
                  onclick="clearDropped()"
                >
                  Xóa ảnh đã thả
                </button>
              </div>
            </div>
          </div>
          <!-- ===== END DROP ZONE ===== -->

          <div id="flowList">
            <div class="frame-group" data-index="0">
              <div class="images-container">
                <div class="image-box">
                  <span>Start Frame</span>
                  <img
                    src="https://cdn-media.sforum.vn/storage/app/media/ctvseo_maihue/hinh-nen-1920-1080/hinh-nen-1920-1080-thumbnail.jpg"
                    class="thumbnail"
                    onclick="triggerUpload(this)"
                    style="cursor: pointer"
                  />
                  <input
                    type="file"
                    name="start_images[0]"
                    accept="image/*"
                    style="display: none"
                    onchange="previewImage(this)"
                  />
                </div>

                <span class="material-symbols-outlined arrow-sep"
                  >sync_alt</span
                >

                <div class="image-box end-frame-box">
                  <span>End Frame</span>
                  <img
                    src="https://cdn-media.sforum.vn/storage/app/media/thunguyen/hinh-nen-vui-ve-2.jpg"
                    class="thumbnail"
                    onclick="triggerUpload(this)"
                    style="cursor: pointer"
                  />
                  <input
                    type="file"
                    name="end_images[0]"
                    accept="image/*"
                    style="display: none"
                    onchange="previewImage(this)"
                  />
                </div>

                <textarea
                  name="prompts[0]"
                  class="prompt-area"
                  placeholder="Nhập prompt..."
                ></textarea>
              </div>
            </div>
          </div>

          <div class="add-row">
            <button
              type="button"
              class="btn-add-frame"
              onclick="addFullFrame()"
            >
              <span class="material-symbols-outlined">add</span>
            </button>
          </div>
          <div class="settings-row">
            <div class="setting-group">
              <label class="setting-label">Tỉ lệ khung hình:</label>
              <div class="select-wrapper">
                <select name="aspectRatio" class="custom-select">
                  <option value="16:9" selected>Ngang</option>
                  <option value="9:16">Dọc</option>
                </select>
              </div>
            </div>

            <div class="setting-group">
              <label class="setting-label">Model:</label>
              <div class="select-wrapper">
                <select name="modelType" class="custom-select">
                  <option value="Veo 3.1 - Lite [Lower Priority]">
                    Veo 3.1 - Lite [Lower Priority]
                  </option>
                  <option value="Veo 3.1 - Fast [Lower Priority] (leaving 5/10)">
                    Veo 3.1 - Fast [Lower Priority] (leaving 5/10)
                  </option>
                  <option value="Veo 3.1 - Lite" selected>Veo 3.1 - Lite</option>
                  <option value="Veo 3.1 - Fast">Veo 3.1 - Fast</option>
                  <option value="Veo 3.1 - Quality">Veo 3.1 - Quality</option>
                </select>
              </div>
            </div>
          </div>
          <div class="footer">
            <button type="submit" class="btn-submit">
              <span class="material-symbols-outlined">arrow_forward</span>
            </button>
          </div>
        </form>
      </div>
      <script>
        function toggleEndFrames() {
          const app = document.getElementById("mainApp");
          app.classList.toggle("hide-end");
        }

        // Validate form trước khi gửi (Check task trước khi check agent)
        document
          .getElementById("renderForm")
          .addEventListener("submit", function (e) {
            const groups = document.querySelectorAll(".frame-group");
            let hasData = false;

            groups.forEach((group) => {
              const prompt = group.querySelector("textarea").value.trim();
              const startInput = group.querySelector(
                'input[name^="start_images"]',
              );
              const endInput = group.querySelector('input[name^="end_images"]');
              if (
                prompt ||
                (startInput && startInput.files.length > 0) ||
                (endInput && endInput.files.length > 0)
              ) {
                hasData = true;
              }
            });

            if (!hasData) {
              e.preventDefault();
              alert(
                "Không có task hợp lệ! Vui lòng nhập prompt hoặc chọn ảnh.",
              );
            }
          });

        function reindexFrames() {
          document
            .querySelectorAll("#flowList .frame-group")
            .forEach((group, i) => {
              group.dataset.index = i;
              const startInput = group.querySelector(
                'input[name^="start_images"]',
              );
              const endInput = group.querySelector('input[name^="end_images"]');
              const textarea = group.querySelector("textarea");
              if (startInput) startInput.name = `start_images[${i}]`;
              if (endInput) endInput.name = `end_images[${i}]`;
              if (textarea) textarea.name = `prompts[${i}]`;
            });
        }

        function addFullFrame() {
          const list = document.getElementById("flowList");
          const idx = list.querySelectorAll(".frame-group").length;
          const frameHTML = `
          <div class="frame-group extra-frame" data-index="${idx}">
            <button class="btn-delete" onclick="this.closest('.frame-group').remove(); reindexFrames();"><span class="material-symbols-outlined">close</span></button>
            <div class="images-container">
              <div class="image-box">
                <span>Start Frame</span>
                <img src="https://cdn-media.sforum.vn/storage/app/media/ctvseo_maihue/hinh-nen-1920-1080/hinh-nen-1920-1080-thumbnail.jpg" class="thumbnail" onclick="triggerUpload(this)" style="cursor:pointer"/>
                <input type="file" name="start_images[${idx}]" accept="image/*" style="display:none" onchange="previewImage(this)"/>
              </div>
              <span class="material-symbols-outlined arrow-sep">sync_alt</span>
              <div class="image-box end-frame-box">
                <span>End Frame</span>
                <img src="https://cdn-media.sforum.vn/storage/app/media/thunguyen/hinh-nen-vui-ve-2.jpg" class="thumbnail" onclick="triggerUpload(this)" style="cursor:pointer"/>
                <input type="file" name="end_images[${idx}]" accept="image/*" style="display:none" onchange="previewImage(this)"/>
              </div>
              <textarea name="prompts[${idx}]" class="prompt-area" placeholder="Nhập prompt..."></textarea>
            </div>
          </div>`;
          list.insertAdjacentHTML("beforeend", frameHTML);
        }

        function clearAll() {
          // Xóa tất cả các frame phụ (những cái được thêm qua nút +)
          document
            .querySelectorAll(".extra-frame")
            .forEach((el) => el.remove());

          // Reset nội dung của frame gốc đầu tiên về trạng thái ban đầu
          const firstFrame = document.querySelector("#flowList .frame-group");
          if (firstFrame) {
            const startImg = firstFrame.querySelector(
              ".image-box:not(.end-frame-box) .thumbnail",
            );
            const endImg = firstFrame.querySelector(
              ".end-frame-box .thumbnail",
            );
            const startInput = firstFrame.querySelector(
              'input[name^="start_images"]',
            );
            const endInput = firstFrame.querySelector(
              'input[name^="end_images"]',
            );
            const prompt = firstFrame.querySelector("textarea");

            if (startImg)
              startImg.src =
                "https://cdn-media.sforum.vn/storage/app/media/ctvseo_maihue/hinh-nen-1920-1080/hinh-nen-1920-1080-thumbnail.jpg";
            if (endImg)
              endImg.src =
                "https://cdn-media.sforum.vn/storage/app/media/thunguyen/hinh-nen-vui-ve-2.jpg";
            if (startInput) startInput.value = "";
            if (endInput) endInput.value = "";
            if (prompt) prompt.value = "";
          }

          reindexFrames();
        }
        function triggerUpload(img) {
          img.nextElementSibling.click();
        }
        function previewImage(input) {
          if (input.files && input.files[0]) {
            const reader = new FileReader();
            reader.onload = (e) => {
              input.previousElementSibling.src = e.target.result;
            };
            reader.readAsDataURL(input.files[0]);
          }
        }

        // ===== DROP ZONE LOGIC =====
        let droppedFiles = [];
        let dropMode = "alternate";

        // Drag-over toàn drop zone
        const dropZoneEl = document.getElementById("dropZone");
        dropZoneEl.addEventListener("dragover", (e) => {
          e.preventDefault();
          dropZoneEl.classList.add("drag-over");
        });
        dropZoneEl.addEventListener("dragleave", (e) => {
          if (!dropZoneEl.contains(e.relatedTarget))
            dropZoneEl.classList.remove("drag-over");
        });
        dropZoneEl.addEventListener("drop", (e) => {
          e.preventDefault();
          dropZoneEl.classList.remove("drag-over");
          const files = [...e.dataTransfer.files].filter((f) =>
            f.type.startsWith("image/"),
          );
          if (files.length) {
            droppedFiles.push(...files);
            renderDropped();
          }
        });

        function handleFileSelect(input) {
          const files = [...input.files].filter((f) =>
            f.type.startsWith("image/"),
          );
          if (files.length) {
            droppedFiles.push(...files);
            renderDropped();
          }
          input.value = "";
        }

        function setDropMode(mode) {
          dropMode = mode;
          document.querySelectorAll(".mode-btn").forEach((btn) => {
            btn.classList.toggle("active", btn.dataset.mode === mode);
          });
          updateDropHint();
        }

        function computeFrameCount() {
          if (dropMode === "alternate")
            return Math.ceil(droppedFiles.length / 2);
          return droppedFiles.length;
        }

        function updateDropHint() {
          const hint = document.getElementById("dropModeHint");
          const btn = document.getElementById("btnApplyDrop");
          const n = droppedFiles.length;
          const fc = computeFrameCount();
          if (dropMode === "alternate") {
            hint.textContent = `${n} ảnh → ${fc} frame (cặp Start+End)`;
          } else if (dropMode === "start") {
            hint.textContent = `${n} ảnh → ${fc} frame (mỗi ảnh là Start)`;
          } else {
            hint.textContent = `${n} ảnh → ${fc} frame (mỗi ảnh là End)`;
          }
          btn.innerHTML = `<span class="material-symbols-outlined" style="font-size:16px">auto_fix_high</span> Tạo ${fc} frame${fc !== 1 ? "s" : ""}`;
        }

        function renderDropped() {
          const thumbsDiv = document.getElementById("dropThumbs");
          const previewDiv = document.getElementById("dropPreview");
          const dropAreaEl = document.getElementById("dropArea");
          const countLabel = document.getElementById("dropCountLabel");

          if (droppedFiles.length === 0) {
            previewDiv.style.display = "none";
            dropAreaEl.style.display = "flex";
            return;
          }

          previewDiv.style.display = "flex";
          dropAreaEl.style.display = "none";
          countLabel.textContent = `${droppedFiles.length} ảnh`;

          thumbsDiv.innerHTML = "";
          droppedFiles.forEach((file, i) => {
            const url = URL.createObjectURL(file);
            const item = document.createElement("div");
            item.className = "drop-thumb-item";
            item.innerHTML = `
              <img src="${url}" title="${file.name}" />
              <span class="thumb-order">${i + 1}</span>
              <button class="remove-thumb" type="button" onclick="removeDropped(${i})">×</button>
            `;
            thumbsDiv.appendChild(item);
          });

          updateDropHint();
        }

        function removeDropped(idx) {
          droppedFiles.splice(idx, 1);
          renderDropped();
        }

        function clearDropped() {
          droppedFiles = [];
          renderDropped();
        }

        function applyDropped() {
          if (droppedFiles.length === 0) return;

          // Tự động hiện End Frame nếu người dùng kéo ảnh vào ở chế độ End hoặc Xen kẽ
          if (dropMode === "alternate" || dropMode === "end") {
            document.getElementById("mainApp").classList.remove("hide-end");
          }

          if (dropMode === "alternate") {
            const pairs = [];
            for (let i = 0; i < droppedFiles.length; i += 2) {
              pairs.push([droppedFiles[i], droppedFiles[i + 1] || null]);
            }

            const emptyFrames = [
              ...document.querySelectorAll("#flowList .frame-group"),
            ].filter((f) => {
              const s = f.querySelector('input[name^="start_images"]');
              const e = f.querySelector('input[name^="end_images"]');
              return (
                (!s || s.files.length === 0) && (!e || e.files.length === 0)
              );
            });

            pairs.forEach((pair, idx) => {
              let frame;
              if (idx < emptyFrames.length) {
                frame = emptyFrames[idx];
              } else {
                addFullFrame();
                const all = document.querySelectorAll("#flowList .frame-group");
                frame = all[all.length - 1];
              }
              fillFrame(frame, pair[0], pair[1]);
            });
          } else if (dropMode === "start") {
            // Ưu tiên 1: Frame đã có End nhưng chưa có Start
            // Ưu tiên 2: Frame trống hoàn toàn
            const allFrames = [
              ...document.querySelectorAll("#flowList .frame-group"),
            ];
            const needStart = allFrames.filter((f) => {
              const s = f.querySelector('input[name^="start_images"]');
              const e = f.querySelector('input[name^="end_images"]');
              return (!s || s.files.length === 0) && e && e.files.length > 0;
            });
            const emptyFrames = allFrames.filter((f) => {
              const s = f.querySelector('input[name^="start_images"]');
              const e = f.querySelector('input[name^="end_images"]');
              return (
                (!s || s.files.length === 0) && (!e || e.files.length === 0)
              );
            });

            let targets = [...needStart, ...emptyFrames];

            droppedFiles.forEach((file) => {
              let frame;
              if (targets.length > 0) {
                frame = targets.shift();
              } else {
                addFullFrame();
                const all = document.querySelectorAll("#flowList .frame-group");
                frame = all[all.length - 1];
              }
              fillFrame(frame, file, null);
            });
          } else if (dropMode === "end") {
            // Ưu tiên 1: Các frame đã có Start nhưng chưa có End
            // Ưu tiên 2: Frame trống hoàn toàn
            const allFrames = [
              ...document.querySelectorAll("#flowList .frame-group"),
            ];
            const needEnd = allFrames.filter((f) => {
              const s = f.querySelector('input[name^="start_images"]');
              const e = f.querySelector('input[name^="end_images"]');
              return s && s.files.length > 0 && (!e || e.files.length === 0);
            });
            const emptyFrames = allFrames.filter((f) => {
              const s = f.querySelector('input[name^="start_images"]');
              const e = f.querySelector('input[name^="end_images"]');
              return (
                (!s || s.files.length === 0) && (!e || e.files.length === 0)
              );
            });

            let targets = [...needEnd, ...emptyFrames];

            droppedFiles.forEach((file) => {
              let frame;
              if (targets.length > 0) {
                frame = targets.shift();
              } else {
                addFullFrame();
                const all = document.querySelectorAll("#flowList .frame-group");
                frame = all[all.length - 1];
              }
              fillFrame(frame, null, file);
            });
          }

          clearDropped();
        }

        function fillFrame(frame, startFile, endFile) {
          if (startFile) {
            const input = frame.querySelector('input[name^="start_images"]');
            const img = frame.querySelector(
              ".image-box:not(.end-frame-box) .thumbnail",
            );
            const dt = new DataTransfer();
            dt.items.add(startFile);
            input.files = dt.files;
            img.src = URL.createObjectURL(startFile);
          }
          if (endFile) {
            const input = frame.querySelector('input[name^="end_images"]');
            const img = frame.querySelector(".end-frame-box .thumbnail");
            const dt = new DataTransfer();
            dt.items.add(endFile);
            input.files = dt.files;
            img.src = URL.createObjectURL(endFile);
          }
        }
        // ===== END DROP ZONE LOGIC =====
      </script>
    </div>
    <script src="/javascripts/spa.js"></script>
  </body>
</html>
