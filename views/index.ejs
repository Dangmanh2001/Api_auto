<!DOCTYPE html>
<html lang="vi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>API Tool</title>
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20,400,0,0"
    />
    <style>
      :root {
        --bg-dark: #1a1c1e;
        --card-bg: #212429;
        --border-color: #3f444c;
        --text-main: #e2e2e2;
        --text-dim: #9aa0a6;
        --accent-blue: #4d94ff;
      }

      * { box-sizing: border-box; margin: 0; padding: 0; }

      body {
        background-color: var(--bg-dark);
        color: var(--text-main);
        font-family: "Segoe UI", Roboto, sans-serif;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 60px 20px;
      }

      h1 {
        font-size: 28px;
        margin-bottom: 8px;
      }

      p.sub {
        color: var(--text-dim);
        margin-bottom: 40px;
        font-size: 15px;
      }

      .grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 16px;
        width: 100%;
        max-width: 860px;
      }

      .card {
        background: var(--card-bg);
        border: 1px solid var(--border-color);
        border-radius: 14px;
        padding: 24px 20px;
        text-decoration: none;
        color: var(--text-main);
        display: flex;
        flex-direction: column;
        gap: 10px;
        transition: border-color 0.2s, background 0.2s;
      }

      .card:hover {
        border-color: var(--accent-blue);
        background: #252a30;
      }

      .card .icon {
        font-size: 28px;
        color: var(--accent-blue);
      }

      .card h3 {
        font-size: 16px;
      }

      .card p {
        font-size: 13px;
        color: var(--text-dim);
        line-height: 1.5;
      }

    </style>
  </head>
  <body>
    <h1>API Tool</h1>
    <p class="sub">Chọn công cụ bạn muốn sử dụng</p>

    <div class="grid">
      <a href="/api" class="card">
        <span class="material-symbols-outlined icon">text_to_speech</span>
        <h3>Text To Video</h3>
        <p>Tạo video từ văn bản mô tả.</p>
      </a>

      <a href="/api/gemini" class="card">
        <span class="material-symbols-outlined icon">auto_awesome</span>
        <h3>Gemini</h3>
        <p>Tương tác với mô hình Gemini AI.</p>
      </a>

      <a href="/api/imageToVideo" class="card">
        <span class="material-symbols-outlined icon">movie</span>
        <h3>Image To Video</h3>
        <p>Tạo video từ ảnh đầu vào và prompt.</p>
      </a>

      <a href="/api/IngredientsToVideo" class="card">
        <span class="material-symbols-outlined icon">restaurant</span>
        <h3>Ingredients To Video</h3>
        <p>Tạo video từ danh sách nguyên liệu.</p>
      </a>

      <a href="/api/clone-channel" class="card">
        <span class="material-symbols-outlined icon">content_copy</span>
        <h3>Clone YouTube Channel</h3>
        <p>Phân tích kênh đối thủ: video, tiêu đề, mô tả, tags, transcript.</p>
      </a>

      <a href="/api/textToImage" class="card">
        <span class="material-symbols-outlined icon">image</span>
        <h3>Text To Image</h3>
        <p>Tạo ảnh từ văn bản mô tả.</p>
      </a>

      <a href="/api/timeslapImage" class="card">
        <span class="material-symbols-outlined icon">auto_awesome_motion</span>
        <h3>Timeslap Image</h3>
        <p>Tao chuoi anh cung chu the theo nhieu moc thoi gian.</p>
      </a>
    </div>

  </body>
</html>
