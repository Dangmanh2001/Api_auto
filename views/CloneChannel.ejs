<!DOCTYPE html>
<html lang="vi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Clone YouTube Channel</title>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20,400,0,0" />
    <style>
      :root {
        --bg-dark: #1a1c1e;
        --card-bg: #212429;
        --border-color: #3f444c;
        --text-main: #e2e2e2;
        --text-dim: #9aa0a6;
        --accent-blue: #4d94ff;
        --accent-red: #ff4444;
      }
      * { box-sizing: border-box; margin: 0; padding: 0; }
      body {
        background: var(--bg-dark);
        color: var(--text-main);
        font-family: "Segoe UI", Roboto, sans-serif;
        min-height: 100vh;
        padding: 40px 20px;
      }
      nav {
        width: 100%; display: flex; align-items: center;
        gap: 8px; margin-bottom: 32px; flex-wrap: wrap;
      }
      .nav-brand {
        font-size: 18px; font-weight: bold; color: white;
        text-decoration: none; margin-right: 16px;
      }
      nav a {
        text-decoration: none; color: var(--text-dim);
        font-size: 14px; padding: 6px 12px;
        border-radius: 20px; border: 1px solid transparent;
        transition: all 0.2s;
      }
      nav a:hover { color: var(--text-main); border-color: var(--border-color); }
      nav a.active { color: var(--accent-blue); border-color: var(--accent-blue); }
      .page { max-width: 1100px; margin: 0 auto; }

      .search-box {
        background: var(--card-bg); border: 1px solid var(--border-color);
        border-radius: 14px; padding: 24px; margin-bottom: 24px;
      }
      .row { display: flex; gap: 12px; flex-wrap: wrap; align-items: flex-end; }
      .input-group { display: flex; flex-direction: column; gap: 6px; flex: 1; min-width: 220px; }
      label { font-size: 12px; color: var(--text-dim); }
      input[type="text"] {
        background: #131517; border: 1px solid var(--border-color);
        border-radius: 8px; color: var(--text-main);
        padding: 10px 14px; font-size: 14px; outline: none;
        transition: border-color 0.2s; width: 100%;
      }
      input:focus { border-color: var(--accent-blue); }
      .btn {
        border: none; border-radius: 8px; padding: 10px 22px;
        font-size: 14px; cursor: pointer;
        display: flex; align-items: center; gap: 6px;
        transition: opacity 0.2s; white-space: nowrap;
      }
      .btn-primary { background: var(--accent-blue); color: #fff; }
      .btn-sm { padding: 5px 12px; font-size: 12px; border-radius: 6px; }
      .btn-ghost { background: #2a2d33; color: var(--text-dim); border: 1px solid var(--border-color); }
      .btn:hover { opacity: 0.85; }
      .btn:disabled { opacity: 0.4; cursor: not-allowed; }

      .spinner {
        display: none; width: 20px; height: 20px;
        border: 2px solid #444; border-top-color: var(--accent-blue);
        border-radius: 50%; animation: spin 0.7s linear infinite;
      }
      @keyframes spin { to { transform: rotate(360deg); } }
      .error-msg { color: var(--accent-red); font-size: 13px; margin-top: 12px; display: none; }

      /* Channel info */
      #channelInfo {
        display: none; background: var(--card-bg);
        border: 1px solid var(--border-color); border-radius: 14px;
        padding: 20px 24px; margin-bottom: 24px;
        align-items: center; gap: 16px; flex-wrap: wrap;
      }
      #channelInfo img { width: 64px; height: 64px; border-radius: 50%; object-fit: cover; }
      .ch-meta h2 { font-size: 18px; margin-bottom: 4px; }
      .ch-meta p { font-size: 13px; color: var(--text-dim); max-width: 500px; }
      .ch-stats { display: flex; gap: 24px; margin-left: auto; }
      .stat-item { text-align: center; }
      .stat-item .val { font-size: 16px; font-weight: 600; color: var(--accent-blue); }
      .stat-item .lbl { font-size: 11px; color: var(--text-dim); margin-top: 2px; }

      /* Video list */
      #videoList { display: none; }
      .section-title {
        font-size: 15px; font-weight: 600; margin-bottom: 16px;
        display: flex; align-items: center; gap: 8px;
      }
      .count-badge {
        background: var(--accent-blue); color: #fff;
        border-radius: 20px; padding: 2px 10px; font-size: 12px;
      }
      .video-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(310px, 1fr));
        gap: 16px; margin-bottom: 20px;
      }
      .video-card {
        background: var(--card-bg); border: 1px solid var(--border-color);
        border-radius: 12px; overflow: hidden; transition: border-color 0.2s;
      }
      .video-card:hover { border-color: var(--accent-blue); }
      .thumb-wrap { position: relative; }
      .thumb-wrap img { width: 100%; aspect-ratio: 16/9; object-fit: cover; display: block; }
      .duration-badge {
        position: absolute; bottom: 6px; right: 6px;
        background: rgba(0,0,0,0.8); color: #fff;
        font-size: 11px; padding: 2px 6px; border-radius: 4px;
      }
      .video-body { padding: 14px; }
      .video-title {
        font-size: 14px; font-weight: 600; line-height: 1.4; margin-bottom: 8px;
        display: -webkit-box; -webkit-line-clamp: 2;
        -webkit-box-orient: vertical; overflow: hidden;
      }
      .video-meta {
        display: flex; gap: 12px; font-size: 12px;
        color: var(--text-dim); margin-bottom: 10px; flex-wrap: wrap;
      }
      .video-meta span { display: flex; align-items: center; gap: 3px; }
      .video-actions { display: flex; gap: 6px; flex-wrap: wrap; }

      #loadMoreArea { text-align: center; padding: 10px 0 24px; display: none; }

      /* Modal */
      .modal-overlay {
        display: none; position: fixed; inset: 0;
        background: rgba(0,0,0,0.75); z-index: 1000;
        align-items: center; justify-content: center;
        padding: 20px;
      }
      .modal-overlay.active { display: flex; }
      .modal {
        background: var(--card-bg); border: 1px solid var(--border-color);
        border-radius: 14px; width: 100%; max-width: 700px;
        max-height: 88vh; display: flex; flex-direction: column;
      }
      .modal-wide { max-width: 860px; }
      .modal-head {
        display: flex; align-items: center; justify-content: space-between;
        padding: 16px 22px; border-bottom: 1px solid var(--border-color);
        flex-shrink: 0;
      }
      .modal-head h3 { font-size: 15px; font-weight: 600; }
      .modal-body { padding: 18px 22px; overflow-y: auto; flex: 1; display: flex; flex-direction: column; gap: 16px; }
      .modal-body textarea {
        width: 100%; min-height: 180px; background: #131517;
        border: 1px solid var(--border-color); border-radius: 8px;
        color: var(--text-main); padding: 12px; font-size: 13px;
        resize: vertical; outline: none; line-height: 1.7; font-family: inherit;
      }
      .modal-foot {
        padding: 12px 22px; border-top: 1px solid var(--border-color);
        display: flex; gap: 8px; justify-content: flex-end; flex-shrink: 0;
      }

      /* AI action buttons */
      .ai-actions {
        background: #181a1e; border: 1px solid var(--border-color);
        border-radius: 10px; padding: 14px;
      }
      .ai-actions-title {
        display: flex; align-items: center; gap: 6px;
        font-size: 13px; font-weight: 600; margin-bottom: 12px;
      }
      .ai-btn-row {
        display: grid; grid-template-columns: repeat(5, 1fr); gap: 8px;
      }
      @media (max-width: 640px) { .ai-btn-row { grid-template-columns: repeat(2, 1fr); } }
      .ai-btn {
        background: var(--card-bg); border: 1px solid var(--border-color);
        border-radius: 10px; padding: 12px 8px; cursor: pointer;
        display: flex; flex-direction: column; align-items: center; gap: 6px;
        transition: border-color 0.2s, background 0.2s; text-align: center;
      }
      .ai-btn:hover { border-color: var(--accent-blue); background: #252a33; }
      .ai-btn:disabled { opacity: 0.4; cursor: not-allowed; }
      .ai-btn .material-symbols-outlined { font-size: 22px; color: var(--accent-blue); }
      .ai-btn-label { font-size: 12px; font-weight: 600; color: var(--text-main); line-height: 1.3; }
      .ai-btn-sub { font-size: 11px; color: var(--text-dim); line-height: 1.3; }

      /* AI result */
      .ai-result-head {
        display: flex; align-items: center; justify-content: space-between;
        margin-bottom: 8px;
      }
      #aiResultText { min-height: 220px; }

      .toast {
        position: fixed; bottom: 24px; right: 24px;
        background: #2e7d32; color: #fff; padding: 10px 20px;
        border-radius: 8px; font-size: 14px; opacity: 0;
        transition: opacity 0.3s; pointer-events: none; z-index: 9999;
      }
      .toast.show { opacity: 1; }
    </style>
  </head>
  <body>
    <div class="page">
      <nav>
        <a class="nav-brand">API Tool</a>
        <a href="/">Home</a>
        <a href="/api">Text To Video</a>
        <a href="/api/gemini">Gemini</a>
        <a href="/api/imageToVideo">Image To Video</a>
        <a href="/api/IngredientsToVideo">Ingredients To Video</a>
        <a href="/api/clone-channel" class="active">Clone YouTube</a>
        <a href="/api/textToImage">Text To Image</a>
      </nav>

      <!-- Search -->
      <div class="search-box">
        <div class="row">
          <div class="input-group">
            <label>URL hoặc Handle kênh YouTube (không cần API key)</label>
            <input id="channelInput" type="text"
              placeholder="VD: @MrBeast  hoặc  youtube.com/channel/UC..." />
          </div>
          <button class="btn btn-primary" id="fetchBtn" onclick="startFetch()">
            <span class="material-symbols-outlined" style="font-size:16px">search</span> Phân tích
          </button>
          <div class="spinner" id="spinner"></div>
        </div>
        <div class="error-msg" id="errorMsg"></div>
      </div>

      <!-- Channel info -->
      <div id="channelInfo">
        <img id="chThumb" src="" alt="avatar" onerror="this.style.display='none'" />
        <div class="ch-meta">
          <h2 id="chTitle"></h2>
          <p id="chDesc"></p>
        </div>
        <div class="ch-stats">
          <div class="stat-item">
            <div class="val" id="chSubs"></div>
            <div class="lbl">Subscribers</div>
          </div>
        </div>
      </div>

      <!-- Video list -->
      <div id="videoList">
        <div class="section-title">
          <span class="material-symbols-outlined" style="color:var(--accent-blue)">video_library</span>
          Danh sách video
          <span class="count-badge" id="videoCount">0</span>
        </div>
        <div class="video-grid" id="videoGrid"></div>
        <div id="loadMoreArea">
          <button class="btn btn-ghost" id="loadMoreBtn" onclick="loadMore()">
            <span class="material-symbols-outlined" style="font-size:16px">expand_more</span> Tải thêm
          </button>
        </div>
      </div>
    </div>

    <!-- Modal mô tả & tags -->
    <div class="modal-overlay" id="detailModal">
      <div class="modal">
        <div class="modal-head">
          <h3 id="detailModalTitle">Mô tả & Tags</h3>
          <button class="btn btn-ghost btn-sm" onclick="closeDetailModal()">
            <span class="material-symbols-outlined" style="font-size:16px">close</span>
          </button>
        </div>
        <div class="modal-body">
          <textarea id="detailModalText" readonly></textarea>
        </div>
        <div class="modal-foot">
          <button class="btn btn-primary btn-sm" onclick="copyText(document.getElementById('detailModalText').value)">
            <span class="material-symbols-outlined" style="font-size:14px">content_copy</span> Copy
          </button>
          <button class="btn btn-ghost btn-sm" onclick="closeDetailModal()">Đóng</button>
        </div>
      </div>
    </div>

    <!-- Modal Transcript với 5 hành động AI -->
    <div class="modal-overlay" id="transcriptModal">
      <div class="modal modal-wide">
        <div class="modal-head">
          <h3 id="transcriptModalTitle">Transcript</h3>
          <button class="btn btn-ghost btn-sm" onclick="closeTranscriptModal()">
            <span class="material-symbols-outlined" style="font-size:16px">close</span>
          </button>
        </div>
        <div class="modal-body">
          <!-- Transcript text -->
          <textarea id="transcriptText" readonly placeholder="Đang tải..."></textarea>

          <!-- 5 nút hành động AI -->
          <div class="ai-actions">
            <div class="ai-actions-title">
              <span class="material-symbols-outlined" style="font-size:16px;color:var(--accent-blue)">auto_awesome</span>
              Phân tích bằng AI
            </div>
            <div class="ai-btn-row">
              <button class="ai-btn" onclick="analyze('rewrite')">
                <span class="material-symbols-outlined">edit_note</span>
                <span class="ai-btn-label">Viết lại nội dung</span>
                <span class="ai-btn-sub">Tạo kịch bản video mới</span>
              </button>
              <button class="ai-btn" onclick="analyze('analyze')">
                <span class="material-symbols-outlined">analytics</span>
                <span class="ai-btn-label">Phân tích chiến lược</span>
                <span class="ai-btn-sub">Hook, cấu trúc, CTA</span>
              </button>
              <button class="ai-btn" onclick="analyze('seo')">
                <span class="material-symbols-outlined">search</span>
                <span class="ai-btn-label">Tiêu đề & SEO</span>
                <span class="ai-btn-sub">Title, description, tags</span>
              </button>
              <button class="ai-btn" onclick="analyze('translate')">
                <span class="material-symbols-outlined">translate</span>
                <span class="ai-btn-label">Dịch sang tiếng Việt</span>
                <span class="ai-btn-sub">Giữ nguyên ý nghĩa</span>
              </button>
              <button class="ai-btn" onclick="analyze('thumbnail')">
                <span class="material-symbols-outlined">image</span>
                <span class="ai-btn-label">Câu thumbnail viral</span>
                <span class="ai-btn-sub">Text & ý tưởng thumbnail</span>
              </button>
            </div>
          </div>

          <!-- Kết quả AI -->
          <div id="aiResultBox" style="display:none">
            <div class="ai-result-head">
              <span id="aiResultLabel" style="font-size:13px;font-weight:600;color:var(--accent-blue)"></span>
              <button class="btn btn-primary btn-sm" onclick="copyText(document.getElementById('aiResultText').value)">
                <span class="material-symbols-outlined" style="font-size:13px">content_copy</span> Copy
              </button>
            </div>
            <textarea id="aiResultText" readonly></textarea>
          </div>

          <!-- Loading AI -->
          <div id="aiLoading" style="display:none;text-align:center;padding:20px 0">
            <div class="spinner" style="display:inline-block;margin:0 auto"></div>
            <p style="margin-top:10px;font-size:13px;color:var(--text-dim)">Đang xử lý với Gemini AI...</p>
          </div>
        </div>
        <div class="modal-foot">
          <button class="btn btn-ghost btn-sm" onclick="copyText(document.getElementById('transcriptText').value)">
            <span class="material-symbols-outlined" style="font-size:13px">content_copy</span> Copy transcript
          </button>
          <button class="btn btn-ghost btn-sm" onclick="closeTranscriptModal()">Đóng</button>
        </div>
      </div>
    </div>

    <div class="toast" id="toast"></div>

    <script>
      let nextToken = null;
      let totalLoaded = 0;
      let currentChannel = "";

      async function startFetch() {
        currentChannel = document.getElementById("channelInput").value.trim();
        if (!currentChannel) return showError("Vui lòng nhập URL hoặc handle kênh.");
        nextToken = null;
        totalLoaded = 0;
        document.getElementById("videoGrid").innerHTML = "";
        document.getElementById("channelInfo").style.display = "none";
        document.getElementById("videoList").style.display = "none";
        hideError();
        await doFetch();
      }

      async function loadMore() {
        if (!nextToken) return;
        document.getElementById("loadMoreBtn").disabled = true;
        await doFetch(true);
        document.getElementById("loadMoreBtn").disabled = false;
      }

      async function doFetch(more = false) {
        setLoading(true);
        try {
          const params = new URLSearchParams({ channel: currentChannel });
          if (more && nextToken) params.set("continuation", nextToken);

          const res = await fetch(`/api/clone-channel/fetch?${params}`);
          const data = await res.json();
          if (!res.ok) throw new Error(data.error || "Lỗi không xác định");

          if (!more && data.channel) renderChannelInfo(data.channel);
          renderVideos(data.videos || []);

          nextToken = data.nextToken || null;
          totalLoaded += (data.videos || []).length;
          document.getElementById("videoCount").textContent = totalLoaded;
          document.getElementById("videoList").style.display = "block";
          document.getElementById("loadMoreArea").style.display = nextToken ? "block" : "none";
        } catch (err) {
          showError(err.message);
        } finally {
          setLoading(false);
        }
      }

      function renderChannelInfo(ch) {
        document.getElementById("chThumb").src = ch.thumbnail;
        document.getElementById("chTitle").textContent = ch.title;
        document.getElementById("chDesc").textContent =
          (ch.description || "").slice(0, 150) + ((ch.description || "").length > 150 ? "…" : "");
        document.getElementById("chSubs").textContent = ch.subscribers || "—";
        document.getElementById("channelInfo").style.display = "flex";
      }

      function renderVideos(videos) {
        const grid = document.getElementById("videoGrid");
        videos.forEach(v => {
          const card = document.createElement("div");
          card.className = "video-card";
          card.innerHTML = `
            <div class="thumb-wrap">
              <img src="${esc(v.thumb)}" alt="${esc(v.title)}" loading="lazy" />
              ${v.duration ? `<span class="duration-badge">${esc(v.duration)}</span>` : ""}
            </div>
            <div class="video-body">
              <div class="video-title" title="${esc(v.title)}">${esc(v.title)}</div>
              <div class="video-meta">
                ${v.views ? `<span><span class="material-symbols-outlined" style="font-size:14px">visibility</span>${esc(v.views)}</span>` : ""}
                ${v.date  ? `<span><span class="material-symbols-outlined" style="font-size:14px">schedule</span>${esc(v.date)}</span>` : ""}
              </div>
              <div class="video-actions">
                <button class="btn btn-ghost btn-sm" onclick="copyText(${safeJson(v.title)})">
                  <span class="material-symbols-outlined" style="font-size:13px">title</span> Tiêu đề
                </button>
                <button class="btn btn-ghost btn-sm" onclick="openDetail('${v.id}', ${safeJson(v.title)})">
                  <span class="material-symbols-outlined" style="font-size:13px">description</span> Mô tả & Tags
                </button>
                <button class="btn btn-primary btn-sm" onclick="openTranscript('${v.id}', ${safeJson(v.title)})">
                  <span class="material-symbols-outlined" style="font-size:13px">subtitles</span> Transcript
                </button>
                <a class="btn btn-ghost btn-sm" href="https://youtube.com/watch?v=${v.id}" target="_blank" title="Mở video">
                  <span class="material-symbols-outlined" style="font-size:13px">open_in_new</span>
                </a>
              </div>
            </div>`;
          grid.appendChild(card);
        });
      }

      async function openDetail(videoId, title) {
        document.getElementById("detailModalTitle").textContent = "Mô tả & Tags — " + title.slice(0, 50);
        document.getElementById("detailModalText").value = "Đang tải...";
        document.getElementById("detailModal").classList.add("active");
        try {
          const res = await fetch(`/api/clone-channel/detail?videoId=${videoId}`);
          const data = await res.json();
          if (!res.ok) throw new Error(data.error);
          const content = `=== MÔ TẢ ===\n${data.description || "(trống)"}\n\n=== TAGS ===\n${(data.tags || []).join(", ") || "(không có)"}`;
          document.getElementById("detailModalText").value = content;
        } catch (err) {
          document.getElementById("detailModalText").value = "Lỗi: " + err.message;
        }
      }
      function closeDetailModal() {
        document.getElementById("detailModal").classList.remove("active");
      }

      async function openTranscript(videoId, title) {
        document.getElementById("transcriptModalTitle").textContent = title.slice(0, 60);
        document.getElementById("transcriptText").value = "Đang tải transcript...";
        document.getElementById("aiResultBox").style.display = "none";
        document.getElementById("aiLoading").style.display = "none";
        document.getElementById("transcriptModal").classList.add("active");
        try {
          const res = await fetch(`/api/clone-channel/transcript?videoId=${videoId}`);
          const data = await res.json();
          if (!res.ok) throw new Error(data.error);
          document.getElementById("transcriptText").value = data.transcript;
        } catch (err) {
          document.getElementById("transcriptText").value = "Lỗi: " + err.message;
        }
      }
      function closeTranscriptModal() {
        document.getElementById("transcriptModal").classList.remove("active");
      }

      const ACTION_LABELS = {
        rewrite:   "✍ Kịch bản video mới",
        analyze:   "📊 Phân tích chiến lược",
        seo:       "🔍 Tiêu đề & SEO",
        translate: "🌐 Bản dịch tiếng Việt",
        thumbnail: "🎯 Câu thumbnail viral",
      };

      async function analyze(action) {
        const transcript = document.getElementById("transcriptText").value;
        if (!transcript || transcript.startsWith("Đang tải") || transcript.startsWith("Lỗi"))
          return showToast("Chờ transcript tải xong!");

        // Disable all AI buttons
        document.querySelectorAll(".ai-btn").forEach(b => b.disabled = true);
        document.getElementById("aiResultBox").style.display = "none";
        document.getElementById("aiLoading").style.display = "block";

        try {
          const res = await fetch("/api/clone-channel/analyze", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ transcript, action }),
          });
          const data = await res.json();
          if (!res.ok) throw new Error(data.error);

          document.getElementById("aiResultLabel").textContent = ACTION_LABELS[action] || "Kết quả AI";
          document.getElementById("aiResultText").value = data.result;
          document.getElementById("aiResultBox").style.display = "block";
        } catch (err) {
          document.getElementById("aiResultLabel").textContent = "Lỗi";
          document.getElementById("aiResultText").value = "Lỗi: " + err.message;
          document.getElementById("aiResultBox").style.display = "block";
        } finally {
          document.getElementById("aiLoading").style.display = "none";
          document.querySelectorAll(".ai-btn").forEach(b => b.disabled = false);
        }
      }

      function copyText(text) {
        navigator.clipboard.writeText(text).then(() => showToast("Đã copy!"));
      }

      function showToast(msg) {
        const t = document.getElementById("toast");
        t.textContent = msg;
        t.classList.add("show");
        setTimeout(() => t.classList.remove("show"), 2000);
      }

      function setLoading(on) {
        document.getElementById("fetchBtn").disabled = on;
        document.getElementById("spinner").style.display = on ? "block" : "none";
      }

      function showError(msg) {
        const el = document.getElementById("errorMsg");
        el.textContent = "⚠ " + msg;
        el.style.display = "block";
      }

      function hideError() {
        document.getElementById("errorMsg").style.display = "none";
      }

      function esc(str) {
        return String(str || "")
          .replace(/&/g, "&amp;").replace(/</g, "&lt;")
          .replace(/>/g, "&gt;").replace(/"/g, "&quot;");
      }

      // JSON.stringify an toàn để nhúng vào onclick="..." (escape dấu ngoặc kép)
      function safeJson(val) {
        return JSON.stringify(val).replace(/"/g, "&quot;");
      }

      document.getElementById("channelInput").addEventListener("keydown", e => {
        if (e.key === "Enter") startFetch();
      });

      document.getElementById("detailModal").addEventListener("click", function(e) {
        if (e.target === this) closeDetailModal();
      });
      document.getElementById("transcriptModal").addEventListener("click", function(e) {
        if (e.target === this) closeTranscriptModal();
      });
    </script>
  </body>
</html>
